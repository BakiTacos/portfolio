---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}

const {
  class: className = '',
  width = 320,
  height = 195,
} = Astro.props;

const uid = 'saki-laptop-' + Math.random().toString(36).substring(2, 9);
const creamGrad = `url(#${uid}-cream)`;
const scarfGrad = `url(#${uid}-scarf)`;
const leatherGrad = `url(#${uid}-leather)`;
const lensGrad = `url(#${uid}-lens)`;
const laptopGrad = `url(#${uid}-laptop)`;
const bagGrad = `url(#${uid}-bag)`;
---

<svg
  viewBox="0 0 330 198"
  width={width}
  height={height}
  role="img"
  aria-label="Saki Working on Laptop"
  class={`saki-laptop-hero-svg select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id={`${uid}-cream`} cx="48%" cy="35%" r="72%">
      <stop offset="0%" stop-color="#FFFDF9" />
      <stop offset="68%" stop-color="#FEF7EE" />
      <stop offset="100%" stop-color="#FDE2C8" />
    </radialGradient>

    <linearGradient id={`${uid}-scarf`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFE184" />
      <stop offset="55%" stop-color="#FECD5E" />
      <stop offset="100%" stop-color="#F0B030" />
    </linearGradient>

    <linearGradient id={`${uid}-leather`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#AA7E70" />
      <stop offset="55%" stop-color="#8D6458" />
      <stop offset="100%" stop-color="#6E4B40" />
    </linearGradient>

    <linearGradient id={`${uid}-lens`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#CDE9F6" />
      <stop offset="55%" stop-color="#A6D2E6" />
      <stop offset="100%" stop-color="#86B9D2" />
    </linearGradient>

    <linearGradient id={`${uid}-laptop`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F7F6FA" />
      <stop offset="60%" stop-color="#E5E2EC" />
      <stop offset="100%" stop-color="#D0CCD9" />
    </linearGradient>

    <linearGradient id={`${uid}-bag`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#9EB486" />
      <stop offset="60%" stop-color="#91A672" />
      <stop offset="100%" stop-color="#6E835C" />
    </linearGradient>
  </defs>

  <!-- 1. KUBAH LATAR BIRU LANGIT LEMBUT (PASTEL BLUE DOME) -->
  <path
    d="M 18 190 C 18 96, 86 44, 170 44 C 254 44, 314 96, 314 190 Z"
    fill="#E1F1FA"
  />

  <!-- 2. 3 BERKAS SINAR KUNING CERAH DI KIRI ATAS -->
  <g>
    <path
      d="M 105 32 C 102 27, 105 22, 110 23 C 115 24, 118 28, 120 34 L 124 50 C 125 54, 122 57, 118 57 C 114 56, 111 53, 109 48 Z"
      fill="#FECD5E"
    />
    <path
      d="M 85 45 C 82 41, 84 36, 90 36 C 95 36, 99 39, 103 44 L 112 58 C 114 62, 112 66, 108 66 C 104 66, 100 64, 96 59 Z"
      fill="#FECD5E"
    />
    <path
      d="M 76 68 C 73 65, 75 60, 80 59 C 85 59, 89 61, 94 65 L 104 74 C 107 77, 106 81, 102 82 C 98 82, 93 80, 88 76 Z"
      fill="#FECD5E"
    />
  </g>

  <!-- 3. KARAKTER SAKI KANONIS (Ditranslasi ke Kanan Laptop) -->
  <g transform="translate(66, -4)">
    <!-- Ransel Hijau Sage di Kanan Belakang -->
    <path
      d="M 184 146 C 204 148, 218 164, 220 192 L 176 192 Z"
      fill={bagGrad}
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linejoin="round"
    />

    <!-- Badan Mochi -->
    <path
      d="M 54 162 C 52 176, 54 186, 58 192 L 184 192 C 188 184, 188 172, 186 162 Z"
      fill={creamGrad}
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linejoin="round"
    />

    <!-- Tali Tas Ransel Hijau Sage Kanonis -->
    <path
      d="M 186 160 C 194 172, 194 184, 188 192 L 174 192 C 178 182, 178 170, 176 162 Z"
      fill="#6E835C"
      stroke="#231F25"
      stroke-width="4.2"
      stroke-linejoin="round"
    />

    <!-- Simpul Syal Kuning di Kanan -->
    <path
      d="M 196 150 C 210 150, 218 158, 223 170 C 224 173, 218 178, 208 180 C 198 182, 188 178, 184 170 L 184 154 Z"
      fill={scarfGrad}
      stroke="#231F25"
      stroke-width="4.2"
      stroke-linejoin="round"
    />

    <!-- Syal Segitiga Kuning (Bandana Kanonis SakiGraphicFace) -->
    <path
      d="M 44 150 C 84 166, 156 166, 196 150 C 194 162, 178 176, 154 188 L 124 194 L 82 186 C 60 174, 46 162, 44 150 Z"
      fill={scarfGrad}
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linejoin="round"
    />

    <!-- Kepala Mochi & Jambul Swirl Kanonis -->
    <path
      d="M 88 60 C 120 52, 172 64, 188 110 L 190 126 C 198 128, 204 134, 203 142 C 202 150, 192 156, 178 158 C 144 166, 96 166, 62 158 C 48 156, 38 150, 37 142 C 36 134, 42 128, 50 126 L 52 110 C 64 76, 80 62, 88 60 Z"
      fill={creamGrad}
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linejoin="round"
    />
    <path
      d="M 88 62 C 82 44, 86 26, 102 18 C 118 11, 134 17, 139 30 C 141 34, 138 36, 133 37 C 125 39, 120 45, 119 52 L 122 64 Z"
      fill={creamGrad}
    />
    <path
      d="M 88 58 C 82 42, 86 26, 102 18 C 118 11, 134 17, 139 30 C 141 34, 138 36, 133 37 C 125 39, 120 45, 119 51"
      fill="none"
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Rona Pipi Peach Kanonis -->
    <ellipse cx="76" cy="138" rx="13" ry="8" fill="#FDD5B8" />
    <ellipse cx="164" cy="138" rx="13" ry="8" fill="#FDD5B8" />

    <!-- Kedua Mata Chevron Gembira (> <) Kanonis -->
    <g fill="none" stroke="#231F25" stroke-width="4.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M 86 117 L 99 124 L 86 131" />
      <path d="M 154 117 L 141 124 L 154 131" />
    </g>

    <!-- Hidung Kecil Kanonis -->
    <ellipse cx="120" cy="127" rx="2.5" ry="1.5" fill="#F29A76" />

    <!-- Mulut Ceria Terbuka & Lidah Kanonis -->
    <g>
      <path
        d="M 110 131 Q 116 132 120 128 Q 124 132 130 131 C 132 141, 129 151, 120 151 C 111 151, 108 141, 110 131 Z"
        fill="#86432D"
        stroke="#231F25"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <path
        d="M 112 140 C 116 135, 124 135, 128 140 C 126 146, 123 149, 120 149 C 117 149, 114 146, 112 140 Z"
        fill="#FA9068"
      />
      <path
        d="M 110 131 Q 116 132 120 128 Q 124 132 130 131 C 132 141, 129 151, 120 151 C 111 151, 108 141, 110 131 Z"
        fill="none"
        stroke="#231F25"
        stroke-width="3"
        stroke-linejoin="round"
      />
    </g>

    <!-- Kacamata Goggle Aviator 3-Lapis Kanonis -->
    <path
      d="M 48 124 C 48 106, 56 92, 68 82 L 76 92 C 66 102, 56 114, 50 126 Z"
      fill={leatherGrad}
      stroke="#231F25"
      stroke-width="4.2"
      stroke-linejoin="round"
    />
    <path
      d="M 192 124 C 192 106, 184 92, 172 82 L 164 92 C 174 102, 184 114, 190 126 Z"
      fill={leatherGrad}
      stroke="#231F25"
      stroke-width="4.2"
      stroke-linejoin="round"
    />
    <rect x="111" y="70" width="18" height="14" rx="3" fill={leatherGrad} stroke="#231F25" stroke-width="4.2" />

    <g transform="translate(89 78) rotate(-12)">
      <ellipse cx="0" cy="3" rx="24" ry="19" fill={leatherGrad} stroke="#231F25" stroke-width="4.5" />
      <ellipse cx="0" cy="-2" rx="22" ry="16" fill="#785247" stroke="#231F25" stroke-width="3.8" />
      <ellipse cx="0" cy="-2" rx="18" ry="12.5" fill={lensGrad} stroke="#231F25" stroke-width="3.2" />
      <path d="M -11 6 L -2 -12 L 4 -12 L -5 8 Z" fill="#FFFFFF" opacity="0.88" />
      <path d="M -2 8 L 7 -10 L 10 -9 L 1 9 Z" fill="#FFFFFF" opacity="0.65" />
    </g>

    <g transform="translate(151 78) rotate(12)">
      <ellipse cx="0" cy="3" rx="24" ry="19" fill={leatherGrad} stroke="#231F25" stroke-width="4.5" />
      <ellipse cx="0" cy="-2" rx="22" ry="16" fill="#785247" stroke="#231F25" stroke-width="3.8" />
      <ellipse cx="0" cy="-2" rx="18" ry="12.5" fill={lensGrad} stroke="#231F25" stroke-width="3.2" />
      <path d="M -11 6 L -2 -12 L 4 -12 L -5 8 Z" fill="#FFFFFF" opacity="0.88" />
      <path d="M -2 8 L 7 -10 L 10 -9 L 1 9 Z" fill="#FFFFFF" opacity="0.65" />
    </g>
  </g>

  <!-- 4. LAPTOP SILVER DENGAN STIKER SAKI KANONIS & TANGAN MOCHI -->
  <g transform="translate(84, 144)">
    <!-- Base Keyboard Laptop di Kanan Bawah -->
    <rect
      x="10"
      y="34"
      width="68"
      height="9"
      rx="4"
      fill="#7B798A"
      stroke="#231F25"
      stroke-width="4.2"
    />

    <!-- Layar / Casing Belakang Laptop Miring -->
    <path
      d="M -48 -28 L 36 -28 C 42 -28, 46 -24, 48 -18 L 60 36 C 61 40, 58 43, 53 43 L -26 43 C -31 43, -35 40, -37 35 L -53 -18 C -55 -24, -52 -28, -48 -28 Z"
      fill={laptopGrad}
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linejoin="round"
    />

    <!-- Stiker Mini Kepala Saki Kanonis di Tengah Punggung Laptop -->
    <g transform="translate(-14, -14) scale(0.18)">
      <path
        d="M 44 150 C 84 166, 156 166, 196 150 C 194 162, 178 176, 154 188 L 124 200 L 82 186 Z"
        fill="#FECD5E"
        stroke="#231F25"
        stroke-width="12"
        stroke-linejoin="round"
      />
      <path
        d="M 88 60 C 120 52, 172 64, 188 110 L 190 126 C 198 128, 204 134, 203 142 C 202 150, 192 156, 178 158 C 144 166, 96 166, 62 158 C 48 156, 38 150, 37 142 C 36 134, 42 128, 50 126 L 52 110 C 64 76, 80 62, 88 60 Z"
        fill="#FEF7EE"
        stroke="#231F25"
        stroke-width="12"
        stroke-linejoin="round"
      />
      <path
        d="M 88 58 C 82 42, 86 26, 102 18 C 118 11, 134 17, 139 30 C 141 34, 138 36, 133 37 C 125 39, 120 45, 119 51"
        fill="#FEF7EE"
        stroke="#231F25"
        stroke-width="12"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <ellipse cx="93" cy="124" rx="9" ry="12" fill="#231F25" />
      <ellipse cx="147" cy="124" rx="9" ry="12" fill="#231F25" />
      <g transform="translate(89 78) rotate(-12)">
        <ellipse cx="0" cy="0" rx="24" ry="18" fill="#A6D2E6" stroke="#231F25" stroke-width="12" />
      </g>
      <g transform="translate(151 78) rotate(12)">
        <ellipse cx="0" cy="0" rx="24" ry="18" fill="#A6D2E6" stroke="#231F25" stroke-width="12" />
      </g>
    </g>

    <!-- Tangan Mochi Kanan Bertumpu di Samping Keyboard Laptop -->
    <ellipse
      cx="78"
      cy="34"
      rx="16"
      ry="12"
      fill={creamGrad}
      stroke="#231F25"
      stroke-width="4.5"
    />
  </g>
</svg>
