    stroke-linecap="round"
  />

  {/* =====================================================================
      7. KEPALA MOCHI, PIPI KIRI, & JAMBUL SWIRL
      ===================================================================== */}
  <path
    d="M 89 48 C 82 32, 88 14, 108 7 C 124 2, 137 10, 140 19 C 141 22, 138 23, 133 25 C 125 28, 121 34, 121 40 C 146 44, 172 58, 188 82 L 197 92 C 205 97, 209 105, 207 114 C 206 119, 202 123, 196 126 C 166 140, 126 148, 84 148 C 74 148, 66 151, 56 151 C 45 151, 38 144, 39 134 C 40 125, 47 120, 56 118 C 56 92, 70 58, 89 48 Z"
    fill={`url(#${uid}-cream)`}
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linejoin="round"
  />
  <path
    d="M 65 164 C 72 148, 92 142, 108 148 C 120 154, 122 172, 114 186 C 105 200, 84 206, 66 202 Z"
    fill={`url(#${uid}-bag)`}
