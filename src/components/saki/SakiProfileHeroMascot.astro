    d="M 201 136 C 213 148, 218 166, 214 182 C 211 190, 205 194, 199 194 L 196 142 Z"
    fill={`url(#${uid}-bag)`}
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linejoin="round"
  />

