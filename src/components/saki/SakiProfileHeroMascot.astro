  />
  <path
    d="M 65 166 C 72 151, 90 146, 102 152 C 112 158, 110 176, 99 189 C 88 201, 68 204, 61 193 C 56 185, 58 174, 65 166 Z"
    fill={`url(#${uid}-cream)`}
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linejoin="round"
  />

  {/* =====================================================================
      8. RONA PIPI PEACH HANGAT
      ===================================================================== */}
  <ellipse cx="102" cy="121" rx="13.5" ry="8" transform="rotate(-6 102 121)" fill="#FDD6BA" />
  <ellipse cx="189" cy="103" rx="10.5" ry="7.5" transform="rotate(-6 189 103)" fill="#FDD6BA" />

  {/* =====================================================================
      9. MATA KIRI BULAT BERSINAR & MATA KANAN KEDIP MANIS '<'
      ===================================================================== */}
  <ellipse cx="118" cy="104" rx="6.8" ry="9.8" transform="rotate(-8 118 104)" fill="#231F25" />
  <ellipse cx="116" cy="99.5" rx="2" ry="2.5" fill="#FFFFFF" />
  <path
    d="M 174 87 L 164 95 L 178 98"
    fill="none"
    stroke="#231F25"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  {/* =====================================================================
      10. TITIK HIDUNG & MULUT CERIA TERBUKA DENGAN LIDAH PEACH
      ===================================================================== */}
  <ellipse cx="147" cy="99" rx="3" ry="1.8" fill="#F2C8AD" />
  <path
    d="M 137 107 Q 143 108 147 104 Q 152 107 158 103 C 160 113, 158 126, 149 127 C 141 128, 136 118, 137 107 Z"
    fill="#86432D"
    stroke="#231F25"
    stroke-width="3.2"
    stroke-linejoin="round"
  />
  <path
    d="M 139 117 C 143 111, 153 111, 156 119 C 154 125, 149 127, 145 126 C 141 125, 139 121, 139 117 Z"
    fill="#FA9068"
  />
  <path
    d="M 137 107 Q 143 108 147 104 Q 152 107 158 103 C 160 113, 158 126, 149 127 C 141 128, 136 118, 137 107 Z"
    fill="none"
    stroke="#231F25"
    stroke-width="3.2"
    stroke-linejoin="round"
  />

  {/* =====================================================================
      11. KACAMATA GOGGLE AVIATOR DI DAHI
      ===================================================================== */}
  <path
    d="M 44 120 C 46 106, 56 90, 68 77 L 82 89 C 70 101, 62 111, 56 118 Z"
    fill={`url(#${uid}-leather)`}
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linejoin="round"
  />
  <path
    d="M 66 79 C 64 85, 68 91, 76 93 L 83 87 L 72 75 Z"
    fill="#9E7366"
    stroke="#231F25"
    stroke-width="4"
    stroke-linejoin="round"
  />
  <path
    d="M 178 61 C 186 66, 191 74, 192 82 L 176 72 Z"
    fill={`url(#${uid}-leather)`}
    stroke="#231F25"
    stroke-width="4.2"
    stroke-linejoin="round"
  />
  <path
    d="M 121 52 L 136 50 L 138 64 L 123 66 Z"
    fill={`url(#${uid}-leather)`}
    stroke="#231F25"
    stroke-width="4.2"
    stroke-linejoin="round"
  />

  {/* Lensa Kiri Goggle */}
  <g transform="translate(98 65) rotate(-14)">
    <ellipse cx="0" cy="3" rx="26" ry="20" fill={`url(#${uid}-leather)`} stroke="#231F25" stroke-width="4.5" />
    <ellipse cx="0" cy="-2" rx="24" ry="16.5" fill="#785247" stroke="#231F25" stroke-width="3.8" />
    <ellipse cx="0" cy="-2" rx="20" ry="13" fill={`url(#${uid}-lens)`} stroke="#231F25" stroke-width="3.2" />
    <path d="M -12 7 L -2 -13 L 4 -13 L -6 9 Z" fill="#FFFFFF" opacity="0.9" />
    <path d="M -2 9 L 8 -11 L 11 -10 L 1 10 Z" fill="#FFFFFF" opacity="0.65" />
  </g>

  {/* Lensa Kanan Goggle */}
  <g transform="translate(157 55) rotate(10)">
    <ellipse cx="0" cy="3" rx="23" ry="17" fill={`url(#${uid}-leather)`} stroke="#231F25" stroke-width="4.5" />
    <ellipse cx="0" cy="-2" rx="21" ry="14" fill="#785247" stroke="#231F25" stroke-width="3.8" />
    <ellipse cx="0" cy="-2" rx="17.5" ry="11" fill={`url(#${uid}-lens)`} stroke="#231F25" stroke-width="3.2" />
