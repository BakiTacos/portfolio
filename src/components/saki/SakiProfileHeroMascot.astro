---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}

const {
  class: className = '',
  width = '100%',
  height = '100%',
} = Astro.props;

const uid = 'saki-hero-' + Math.random().toString(36).substring(2, 9);
---

<svg
  viewBox="-10 -5 285 275"
  width={width}
  height={height}
  role="img"
  aria-label="Saki Mascot Waving Cheerful"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    {/* Gradien Krem Mochi untuk Kepala & Tubuh */}
    <radialGradient id={`${uid}-cream`} cx="46%" cy="36%" r="72%">
      <stop offset="0%" stop-color="#FFFDF9" />
      <stop offset="68%" stop-color="#FEF7EE" />
      <stop offset="100%" stop-color="#FDE2C8" />
    </radialGradient>

    {/* Gradien Kuning untuk Syal & Sinar */}
    <linearGradient id={`${uid}-scarf`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFE184" />
      <stop offset="55%" stop-color="#FECD5E" />
      <stop offset="100%" stop-color="#F2B438" />
    </linearGradient>

    {/* Gradien Kulit Cokelat untuk Kacamata Aviator */}
    <linearGradient id={`${uid}-leather`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#A87C6F" />
      <stop offset="55%" stop-color="#8D6458" />
      <stop offset="100%" stop-color="#6E4B40" />
    </linearGradient>

    {/* Gradien Biru Langit untuk Lensa Kacamata */}
    <linearGradient id={`${uid}-lens`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#D2ECF8" />
      <stop offset="55%" stop-color="#A6D2E6" />
      <stop offset="100%" stop-color="#86B9D2" />
    </linearGradient>

    {/* Gradien Hijau Sage untuk Ransel */}
    <linearGradient id={`${uid}-bag`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#9EB486" />
      <stop offset="60%" stop-color="#849B75" />
      <stop offset="100%" stop-color="#6B8064" />
    </linearGradient>
  </defs>

  {/* =====================================================================
      1. BAYANGAN LANTAI (GROUND SHADOW)
      ===================================================================== */}
  <ellipse cx="132" cy="246" rx="84" ry="10" fill="#DFD6CB" opacity="0.85" />

  {/* =====================================================================
      2. 3 BERKAS SINAR KUNING CERAH DI SAMPING KEPALA & TANGAN MELAMBAI
      ===================================================================== */}
  <g>
    <path
      d="M 216 48 C 214 43, 218 39, 224 40 C 229 41, 232 45, 233 50 L 235 68 C 235 73, 231 76, 226 75 C 221 74, 218 70, 217 65 Z"
      fill="#FECD5E"
    />
    <path
      d="M 235 68 C 232 64, 235 59, 241 58 C 246 58, 250 61, 253 66 L 263 83 C 265 88, 263 92, 258 93 C 253 93, 249 90, 247 85 Z"
      fill="#FECD5E"
    />
    <path
      d="M 242 98 C 240 94, 242 89, 248 88 C 253 87, 257 90, 260 94 L 268 111 C 270 115, 267 119, 262 120 C 257 120, 253 117, 252 112 Z"
      fill="#FECD5E"
    />
  </g>

  {/* =====================================================================
      3. RANSEL HIJAU SAGE (BACKPACK DI BELAKANG)
      ===================================================================== */}
  <path
    d="M 42 116 C 34 117, 34 128, 40 133 L 46 129 Z"
    fill="#9BB3A6"
    stroke="#231F25"
    stroke-width="4.2"
    stroke-linejoin="round"
  />
  <path
    d="M 42 168 C 35 184, 37 206, 50 213 C 58 217, 68 216, 75 214 L 66 166 Z"
    fill={`url(#${uid}-bag)`}
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linejoin="round"
  />
  <path
    d="M 49 172 C 46 188, 48 204, 56 211 L 71 211 L 64 170 Z"
    fill="#6F8578"
  />
  <path
    d="M 42 168 C 35 184, 37 206, 50 213 C 58 217, 68 216, 75 214"
    fill="none"
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  {/* =====================================================================
      4. TANGAN KANAN MELAMBAI CERIA KE ATAS
      ===================================================================== */}
  <path
    d="M 204 102 C 218 95, 233 104, 233 121 C 232 137, 222 149, 211 156 L 195 135 Z"
    fill={`url(#${uid}-cream)`}
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linejoin="round"
  />

