    fill="none"
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  {/* =====================================================================
      6. SIMPUL & SYAL KUNING DI BAHU KIRI
      ===================================================================== */}
  <path
    d="M 46 145 C 32 144, 24 152, 17 166 C 16 169, 22 174, 32 177 C 44 179, 55 176, 61 168 L 60 150 Z"
    fill={`url(#${uid}-scarf)`}
    stroke="#231F25"
    stroke-width="4.5"
    stroke-linejoin="round"
  />
  <path
    d="M 58 150 C 55 156, 56 165, 62 169 L 76 154 L 72 147 Z"
    fill="#F3B33D"
    stroke="#231F25"
    stroke-width="4.2"
    stroke-linejoin="round"
  />
  <path
    d="M 96 146 C 136 144, 176 136, 205 121 C 209 123, 207 132, 201 143 C 193 158, 182 170, 172 178 C 169 180, 162 179, 152 176 L 114 164 Z"
