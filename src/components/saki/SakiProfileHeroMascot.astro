  <ellipse cx="104" cy="224" rx="22" ry="10" fill="#FDE0C6" opacity="0.8" />
  <ellipse cx="171" cy="212" rx="22" ry="10" transform="rotate(-12 171 212)" fill="#FDE0C6" opacity="0.8" />
