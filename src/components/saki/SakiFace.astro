---
interface Props {
  size?: number;
  initialMood?: 'idle' | 'excited' | 'presenting' | 'wink' | 'working' | 'coffee' | 'idea';
  showBubble?: boolean;
  class?: string;
}

const {
  size = 96,
  initialMood = 'idle',
  showBubble = true,
  class: className = '',
} = Astro.props;

const uid = 'saki-f-' + Math.random().toString(36).substring(2, 9);
const h = Math.round((size * 260) / 240);
---

<div
  class={`saki-interactive-root ${className}`}
  data-saki-interactive
  data-mood={initialMood}
  style={`width: ${size}px; height: ${h}px; position: relative; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; user-select: none;`}
>
  {showBubble && (
    <div class="saki-speech-pill fl-mono" data-saki-bubble role="status" aria-live="polite">
      <span data-saki-say>Hi! I'm Saki ✦</span>
    </div>
  )}

  <svg
    viewBox="0 0 240 260"
    width={size}
    height={h}
    aria-hidden="true"
    class="saki-interactive-svg"
    style="width: 100%; height: 100%; overflow: visible; display: block;"
    xmlns="http://www.w3.org/2000/svg"
