      <linearGradient id={`${uid}-scarf`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#FFE184" />
        <stop offset="55%" stop-color="#FECD5E" />
        <stop offset="100%" stop-color="#F0B030" />
