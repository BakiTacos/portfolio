</div>

<script>
  const MOOD_TEXTS: Record<string, string> = {
    idle: "Hi! I'm Saki ✦",
    excited: "Let's collaborate! ✉",
    presenting: 'View CV & track record ↗',
    wink: 'Connect on socials ;)',
    working: 'Building scalable systems',
    idea: 'Orchestrating smart workflows',
    coffee: 'Fueled by warm coffee ☕',
  };

  const CYCLE_MOODS = ['idle', 'working', 'idea', 'coffee', 'presenting', 'excited'];

  function initInteractiveSaki() {
    const roots = document.querySelectorAll<HTMLElement>('[data-saki-interactive]');
    roots.forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const eyes = root.querySelector<SVGGElement>('[data-saki-eyes]');
      const sayEl = root.querySelector<HTMLElement>('[data-saki-say]');

      const setMood = (mood: string, customSay?: string) => {
        root.dataset.mood = mood;
        root.setAttribute('data-active-say', 'true');
        if (sayEl) {
          sayEl.textContent = customSay || MOOD_TEXTS[mood] || MOOD_TEXTS.idle;
        }
      };

      window.addEventListener('pointermove', (e) => {
        if (!eyes) return;
        const rect = root.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = Math.max(-1, Math.min(1, (e.clientX - cx) / (window.innerWidth / 2)));
        const dy = Math.max(-1, Math.min(1, (e.clientY - cy) / (window.innerHeight / 2)));
        eyes.style.transform = `translate(${(dx * 5.5).toFixed(1)}px, ${(dy * 4).toFixed(1)}px)`;
      });

      root.addEventListener('click', () => {
        const cur = root.dataset.mood || 'idle';
        const nextIdx = (CYCLE_MOODS.indexOf(cur) + 1) % CYCLE_MOODS.length;
        setMood(CYCLE_MOODS[nextIdx]);
      });

      window.addEventListener('saki:set-mood', ((e: CustomEvent<{ mood: string; say?: string }>) => {
        if (e.detail?.mood) {
          setMood(e.detail.mood, e.detail.say);
        }
      }) as EventListener);
    });
  }

  document.addEventListener('DOMContentLoaded', initInteractiveSaki);
  document.addEventListener('astro:page-load', initInteractiveSaki);
</script>

<style lang="scss">
  .saki-interactive-root {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
  }

  .saki-speech-pill {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(2px);
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    background: rgba(24, 24, 31, 0.92);
    color: #FEF7EE;
    border: 1px solid rgba(254, 205, 94, 0.45);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
  }

  :root:not(.theme-dark) .saki-speech-pill {
    background: #FEF7EE;
    color: #231F25;
    border-color: #F0B030;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  }

  .saki-interactive-root:hover .saki-speech-pill,
  .saki-interactive-root[data-active-say="true"] .saki-speech-pill {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @keyframes saki-bob-kf {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  @keyframes saki-blink-kf {
    0%, 93%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  @keyframes saki-wave-kf {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(12deg); }
  }

  .saki-bob-group {
    animation: saki-bob-kf 3.2s ease-in-out infinite;
  }

  .saki-blink-group {
    transform-box: fill-box;
    transform-origin: center;
    animation: saki-blink-kf 4.2s infinite;
  }

  .saki-eye-look {
    transition: transform 180ms ease-out;
  }

  .saki-wave-anim {
    transform-box: fill-box;
    transform-origin: 0% 100%;
    animation: saki-wave-kf 1.8s ease-in-out infinite;
  }

  .saki-hand-left,
  .saki-hand-right,
  .saki-head-group,
  .saki-prop-idea,
  .saki-prop-chart,
  .saki-prop-laptop,
  .saki-prop-coffee,
  .saki-rays {
    transition: transform 360ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 220ms ease;
  }

  .saki-prop-idea,
  .saki-prop-chart,
  .saki-prop-laptop,
  .saki-prop-coffee,
  .eyes-excited,
  .eyes-coffee,
  .mouth-cat {
    opacity: 0;
    pointer-events: none;
  }

  .saki-hand-right {
    transform-box: view-box;
    transform-origin: 192px 180px;
    transform: translate(6px, -34px) rotate(-26deg);
  }

  .saki-interactive-root[data-mood="excited"] {
    .eyes-normal { opacity: 0; }
    .eyes-excited { opacity: 1; }
    .saki-hand-left {
      transform-box: view-box;
      transform-origin: 48px 180px;
      transform: translate(-6px, -32px) rotate(26deg);
    }
  }

  .saki-interactive-root[data-mood="presenting"] {
    .saki-rays { opacity: 0; }
    .saki-prop-chart { opacity: 1; }
  }

  .saki-interactive-root[data-mood="idea"] {
    .saki-rays { opacity: 0; }
    .saki-prop-idea { opacity: 1; }
    .saki-prop-laptop { opacity: 1; }
    .saki-hand-right { transform: translate(0, 0); }
    .saki-wave-anim { animation: none; }
  }

  .saki-interactive-root[data-mood="working"] {
    .saki-rays { opacity: 0; }
    .saki-prop-laptop { opacity: 1; }
    .mouth-open { opacity: 0; }
    .mouth-cat { opacity: 1; }
    .saki-hand-right { transform: translate(0, 0); }
    .saki-wave-anim { animation: none; }
  }

  .saki-interactive-root[data-mood="coffee"] {
    .saki-rays { opacity: 0; }
    .saki-prop-coffee { opacity: 1; }
    .eyes-normal { opacity: 0; }
    .eyes-coffee { opacity: 1; }
    .mouth-open { opacity: 0; }
    .mouth-cat { opacity: 1; }
    .saki-hand-right { transform: translate(0, 0); }
    .saki-wave-anim { animation: none; }
  }

  .saki-interactive-root[data-mood="wink"] {
    .saki-head-group {
      transform-box: view-box;
      transform-origin: 120px 160px;
      transform: rotate(-4deg);
    }
  }
</style>
