        <circle cx="0" cy="-2" r="6.5" fill="#FFFFFF" opacity="0.9" />
      </g>

      <!-- Mug Kopi (Tampil saat mood=coffee) -->
      <g class="saki-prop-coffee" transform="translate(64 176)">
        <path d="M -22 -8 C -32 -8, -32 14, -22 14" fill="none" stroke="#231F25" stroke-width="4" stroke-linecap="round" />
        <rect x="-22" y="-14" width="32" height="34" rx="6" fill="#FFFFFF" stroke="#231F25" stroke-width="4" />
