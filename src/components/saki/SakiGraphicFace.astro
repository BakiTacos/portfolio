            <path d="M 178 61 C 186 66, 191 74, 192 82 L 176 72 Z" fill={leatherGrad} stroke={C.ink} stroke-width="4.2" stroke-linejoin="round" />
            <path d="M 121 52 L 136 50 L 138 64 L 123 66 Z" fill={leatherGrad} stroke={C.ink} stroke-width="4.2" stroke-linejoin="round" />

            <g transform="translate(98 65) rotate(-14)">
              <ellipse cx="0" cy="3" rx="26" ry="20" fill={leatherGrad} stroke={C.ink} stroke-width="4.5" />
              <ellipse cx="0" cy="-2" rx="24" ry="16.5" fill="#785247" stroke={C.ink} stroke-width="3.8" />
