            />
            <ellipse cx="130" cy="238" rx="78" ry="8.5" fill="#DFD9D8" />
            <path d="M 38 31 C 36 27, 40 23, 45 22 C 50 21, 52 24, 53 29 L 56 45 C 57 49, 54 52, 50 52 C 47 52, 45 49, 43 45 Z" fill={C.yellow} />
            <path d="M 18 48 C 15 52, 15 57, 20 60 L 36 67 C 40 69, 43 67, 43 63 C 43 60, 40 57, 36 54 L 24 46 C 21 44, 19 45, 18 48 Z" fill={C.yellow} />
            <path d="M 18 77 C 16 80, 16 85, 20 86 L 31 86 C 35 85, 36 83, 35 80 C 34 78, 31 77, 24 76 C 20 75, 19 75, 18 77 Z" fill={C.yellow} />

            <path d="M 42 116 C 34 117, 34 128, 40 133 L 46 129 Z" fill="#9BB3A6" stroke={C.ink} stroke-width="4.2" stroke-linejoin="round" />
            <path d="M 42 168 C 35 184, 37 206, 50 213 C 58 217, 68 216, 75 214 L 66 166 Z" fill={bagGrad} stroke={C.ink} stroke-width="4.5" stroke-linejoin="round" />
            <path d="M 49 172 C 46 188, 48 204, 56 211 L 71 211 L 64 170 Z" fill="#6F8578" />
            <path d="M 42 168 C 35 184, 37 206, 50 213 C 58 217, 68 216, 75 214" fill="none" stroke={C.ink} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />

            <path d="M 204 102 C 218 95, 231 103, 231 119 C 230 135, 221 147, 211 154 L 196 134 Z" fill={creamGrad} stroke={C.ink} stroke-width="4.5" stroke-linejoin="round" />
            <path d="M 201 136 C 213 148, 218 166, 214 182 C 211 190, 205 194, 199 194 L 196 142 Z" fill={bagGrad} stroke={C.ink} stroke-width="4.5" stroke-linejoin="round" />

