            <ellipse cx="189" cy="103" rx="10.5" ry="7.5" transform="rotate(-6 189 103)" fill={C.blush} />

            <ellipse cx="118" cy="104" rx="6.8" ry="9.8" transform="rotate(-8 118 104)" fill={C.ink} />
