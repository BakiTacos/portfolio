---
import { SAKI_MOOD_CONFIG, type SakiGraphicMood } from './sakiMoods';

interface Props {
  mood: SakiGraphicMood;
  size?: 'splash' | 'card' | 'compact' | number;
  transparentBg?: boolean;
  class?: string;
  hideBubble?: boolean;
  customSay?: string;
}

const {
  mood = 'hero',
  size = 'card',
  transparentBg = true,
  class: className = '',
  hideBubble = true,
  customSay,
} = Astro.props;

const uid = 'saki-g-' + Math.random().toString(36).substring(2, 9);
const config = SAKI_MOOD_CONFIG[mood] || SAKI_MOOD_CONFIG.hero;
const displayedSay = customSay || config.say;

const C = {
  cream: '#FEF7EE',
  peach: '#FEE0C6',
  yellow: '#FECD5E',
  yellowDark: '#F0B030',
  green: '#91A672',
  greenDark: '#6E835C',
  blue: '#9DC6D8',
  slate: '#343C50',
  ink: '#231F25',
  leather: '#8D6458',
  mouth: '#86432D',
  tongue: '#FA9068',
  blush: '#FDD5B8',
};

const creamGrad = `url(#${uid}-cream)`;
const scarfGrad = `url(#${uid}-scarf)`;
const leatherGrad = `url(#${uid}-leather)`;
const lensGrad = `url(#${uid}-lens)`;
const bagGrad = `url(#${uid}-bag)`;

const svgSize = typeof size === 'number' ? size : size === 'splash' ? 240 : size === 'compact' ? 120 : 185;
const svgWidth = size === 'splash' ? '100%' : `${svgSize}px`;
const svgHeight = size === 'splash' ? '100%' : `${svgSize}px`;
---


    <div
      class={`saki-gf-wrapper ${className}`}
      style={`width: ${svgWidth}; height: ${svgHeight};`}
    >
      {!hideBubble && (
        <div class="saki-gf-bubble">
          {displayedSay}
          <span class="saki-gf-bubble-arrow" />
        </div>
      )}

      <svg
        viewBox="0 0 240 260"
        width={svgSize}
        height={(svgSize * 260) / 240}
        aria-hidden="true"
        class="saki-gf-svg"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <radialGradient id={`${uid}-cream`} cx="48%" cy="35%" r="72%">
            <stop offset="0%" stop-color="#FFFDF9" />
            <stop offset="68%" stop-color={C.cream} />
            <stop offset="100%" stop-color="#FDE2C8" />
          </radialGradient>
          <linearGradient id={`${uid}-scarf`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#FFE184" />
            <stop offset="55%" stop-color={C.yellow} />
            <stop offset="100%" stop-color={C.yellowDark} />
          </linearGradient>
          <linearGradient id={`${uid}-leather`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#AA7E70" />
            <stop offset="55%" stop-color={C.leather} />
            <stop offset="100%" stop-color="#6E4B40" />
          </linearGradient>
          <linearGradient id={`${uid}-lens`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#CDE9F6" />
            <stop offset="55%" stop-color="#A6D2E6" />
            <stop offset="100%" stop-color="#86B9D2" />
          </linearGradient>
          <linearGradient id={`${uid}-bag`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#9EB486" />
            <stop offset="60%" stop-color={C.green} />
            <stop offset="100%" stop-color={C.greenDark} />
          </linearGradient>
          <linearGradient id={`${uid}-laptop`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#B8B6C6" />
            <stop offset="100%" stop-color="#8D8B9C" />
          </linearGradient>
        </defs>

        {!transparentBg && (
          <rect width="240" height="260" rx="24" fill="#FFFFFF" />
        )}

        {/* =========================================================================
            KHUSUS POSE 1: HERO (SAMA PERSIS DENGAN MASKOT UTAMA SAKI.PNG)
            ========================================================================= */}
        {mood === 'hero' ? (
          <g>
            <path
              d="M 38 106 C 14 106, 6 118, 6 142 L 6 198 C 6 218, 18 228, 40 224 L 88 214 L 186 56 C 212 50, 228 60, 228 84 L 228 170 C 228 190, 216 198, 196 201 Z"
