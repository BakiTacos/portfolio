            <ellipse cx="192" cy="209" rx="18" ry="9" transform="rotate(-14 192 209)" fill={C.peach} opacity="0.72" />
            <path
              d="M 138 154 C 168 144, 206 148, 214 182 C 218 204, 204 224, 178 224 L 114 224"
