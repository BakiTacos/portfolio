              <path d="M -2 9 L 8 -11 L 11 -10 L 1 10 Z" fill="#FFFFFF" opacity="0.65" />
            </g>

            <g transform="translate(157 55) rotate(10)">
              <ellipse cx="0" cy="3" rx="23" ry="17" fill={leatherGrad} stroke={C.ink} stroke-width="4.5" />
              <ellipse cx="0" cy="-2" rx="21" ry="14" fill="#785247" stroke={C.ink} stroke-width="3.8" />
              <ellipse cx="0" cy="-2" rx="17.5" ry="11" fill={lensGrad} stroke={C.ink} stroke-width="3.2" />
              <path d="M -10 6 L -1 -11 L 5 -11 L -4 8 Z" fill="#FFFFFF" opacity="0.9" />
              <path d="M -1 8 L 7 -9 L 10 -8 L 2 9 Z" fill="#FFFFFF" opacity="0.65" />
            </g>
          </g>
        ) : mood === 'sleeping' ? (
          /* =========================================================================
             KHUSUS POSE TIDUR PULAS (BARIS 2 #5 SAKI.PNG — KEPALA REBAHAN DI LANTAI)
             ========================================================================= */
          <g>
            {/* Bayangan lantai lebar di bawah seluruh badan & kepala */}
            <ellipse cx="120" cy="227" rx="96" ry="9" fill="#DFD9D8" />

            {/* Huruf z z Z bertingkat di kanan atas (dekat headphone kanan) */}
            <g stroke={C.slate} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none">
              <path d="M 152 104 L 164 104 L 152 116 L 164 116" />
              <path d="M 172 84 L 186 84 L 172 98 L 186 98" />
              <path d="M 194 62 L 210 62 L 194 78 L 210 78" />
            </g>

            {/* Ujung simpul syal kuning di lantai kiri bawah (di bawah pipi kiri) */}
