---
interface Props {
  width?: number;
  showBackdrop?: boolean;
  class?: string;
}

const { width = 200, showBackdrop = true, class: className = '' } = Astro.props;
const uid = 'saki-m-' + Math.random().toString(36).substring(2, 9);
const h = Math.round((width * 260) / 240);

const cream = `url(#${uid}-cream)`;
const scarf = `url(#${uid}-scarf)`;
const leather = `url(#${uid}-leather)`;
const lens = `url(#${uid}-lens)`;
const bag = `url(#${uid}-bag)`;
---

<svg
  viewBox="0 0 240 260"
  width={width}
  height={h}
  role="img"
  aria-label="Saki Mascot"
  class={`select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id={`${uid}-cream`} cx="46%" cy="38%" r="70%">
      <stop offset="0%" stop-color="#FFFDF9" />
      <stop offset="70%" stop-color="#FEF7EE" />
      <stop offset="100%" stop-color="#FDE2C8" />
    </radialGradient>
    <linearGradient id={`${uid}-scarf`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFE184" />
      <stop offset="55%" stop-color="#FECD5E" />
      <stop offset="100%" stop-color="#F0B030" />
    </linearGradient>
    <linearGradient id={`${uid}-leather`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#AA7E70" />
      <stop offset="55%" stop-color="#8D6458" />
      <stop offset="100%" stop-color="#6E4B40" />
    </linearGradient>
    <linearGradient id={`${uid}-lens`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#CDE9F6" />
      <stop offset="55%" stop-color="#A6D2E6" />
      <stop offset="100%" stop-color="#86B9D2" />
    </linearGradient>
    <linearGradient id={`${uid}-bag`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#9EB486" />
      <stop offset="60%" stop-color="#849B75" />
      <stop offset="100%" stop-color="#6B8064" />
    </linearGradient>
  </defs>

  {showBackdrop && (
    <path
      d="M 38 106 C 14 106, 6 118, 6 142 L 6 198 C 6 218, 18 228, 40 224 L 88 214 L 186 56 C 212 50, 228 60, 228 84 L 228 170 C 228 190, 216 198, 196 201 Z"
      fill="#DCECF2"
    />
  )}

  <ellipse cx="130" cy="238" rx="78" ry="8.5" fill="#DFD9D8" opacity="0.65" />

  <path d="M 38 31 C 36 27, 40 23, 45 22 C 50 21, 52 24, 53 29 L 56 45 C 57 49, 54 52, 50 52 C 47 52, 45 49, 43 45 Z" fill="#FECD5E" />
  <path d="M 18 48 C 15 52, 15 57, 20 60 L 36 67 C 40 69, 43 67, 43 63 C 43 60, 40 57, 36 54 L 24 46 C 21 44, 19 45, 18 48 Z" fill="#FECD5E" />
