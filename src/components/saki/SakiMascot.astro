    <ellipse cx="0" cy="-2" rx="21" ry="14" fill="#785247" stroke="#231F25" stroke-width="3.8" />
    <ellipse cx="0" cy="-2" rx="17.5" ry="11" fill={lens} stroke="#231F25" stroke-width="3.2" />
