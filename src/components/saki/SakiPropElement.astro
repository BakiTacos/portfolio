---
import type { SakiPropName } from './sakiMoods';

interface Props {
  name: SakiPropName;
  size?: number;
  class?: string;
}

const { name, size = 36, class: className = '' } = Astro.props;

const C = {
  cream: '#FEF7EE',
  peach: '#FEE0C6',
  yellow: '#FECD5E',
  yellowDark: '#F0B030',
  green: '#91A672',
  greenDark: '#6E835C',
  blue: '#9DC6D8',
  blueDark: '#5D8AA8',
  slate: '#343C50',
  leather: '#8D6458',
  leatherDark: '#6E4B40',
  ink: '#231F25',
};
---

<svg
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  class={`saki-prop-svg select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
>
  {/* 1. GOGGLES — Kacamata Aviator Khas Saki (Props #1 di saki.png) */}
  {name === 'goggles' && (
    <g>
      <ellipse cx="32" cy="52" rx="22" ry="4" fill="rgba(35,31,37,0.14)" />
      <rect x="26" y="27" width="12" height="9" rx="2.5" fill={C.leather} stroke={C.ink} stroke-width="3.2" />
      <g transform="translate(17 33) rotate(-10)">
        <ellipse cx="0" cy="2" rx="13.5" ry="10.5" fill={C.leather} stroke={C.ink} stroke-width="3.2" />
        <ellipse cx="0" cy="-1" rx="10" ry="7.2" fill={C.blue} stroke={C.ink} stroke-width="2.6" />
        <path d="M -5 4 L 0 -6 L 3 -6 L -2 5 Z" fill="#FFFFFF" opacity="0.9" />
      </g>
      <g transform="translate(47 31) rotate(8)">
        <ellipse cx="0" cy="2" rx="13.5" ry="10.5" fill={C.leather} stroke={C.ink} stroke-width="3.2" />
        <ellipse cx="0" cy="-1" rx="10" ry="7.2" fill={C.blue} stroke={C.ink} stroke-width="2.6" />
        <path d="M -5 4 L 0 -6 L 3 -6 L -2 5 Z" fill="#FFFFFF" opacity="0.9" />
      </g>
    </g>
  )}

  {/* 2. BANDANA — Syal Segitiga Kuning Khas Saki (Props #2 di saki.png) */}
  {name === 'bandana' && (
    <g>
      <ellipse cx="32" cy="54" rx="18" ry="4" fill="rgba(35,31,37,0.14)" />
      <path
        d="M 48 16 C 54 14, 58 18, 55 24 C 52 28, 46 28, 44 24 Z"
        fill={C.yellowDark}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path
        d="M 10 18 C 24 22, 40 22, 52 17 C 50 28, 42 40, 34 49 C 31 52, 28 52, 25 49 C 17 40, 11 28, 10 18 Z"
        fill={C.yellow}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path d="M 18 24 C 26 26, 36 26, 44 23" fill="none" stroke={C.yellowDark} stroke-width="2.5" stroke-linecap="round" />
    </g>
  )}

  {/* 3. BACKPACK — Tas Ransel Hijau Sage Khas Saki (Props #3 di saki.png) */}
  {name === 'backpack' && (
    <g>
      <ellipse cx="32" cy="56" rx="20" ry="4" fill="rgba(35,31,37,0.14)" />
      <path d="M 24 14 C 24 8, 40 8, 40 14" fill="none" stroke={C.ink} stroke-width="3.4" stroke-linecap="round" />
      <rect x="13" y="14" width="38" height="38" rx="12" fill={C.green} stroke={C.ink} stroke-width="3.2" />
      <path
        d="M 13 24 C 13 17, 18 14, 25 14 L 39 14 C 46 14, 51 17, 51 24 L 51 28 C 39 33, 25 33, 13 28 Z"
        fill="#A3B886"
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <rect x="28" y="27" width="8" height="10" rx="2.5" fill={C.yellow} stroke={C.ink} stroke-width="2.8" />
    </g>
  )}

  {/* 4. LAPTOP — Laptop Perak/Slate Khas Saki (Props #4 di saki.png) */}
  {name === 'laptop' && (
    <g>
      <ellipse cx="32" cy="54" rx="24" ry="4" fill="rgba(35,31,37,0.14)" />
      <path
        d="M 20 14 L 52 14 C 55 14, 56 16, 55 19 L 48 45 L 14 45 L 17 17 C 17.5 15, 18.5 14, 20 14 Z"
        fill="#A8A6B8"
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <circle cx="34" cy="29" r="4.5" fill="#FFFFFF" opacity="0.92" />
      <rect x="8" y="44" width="44" height="6" rx="3" fill="#7D7B8E" stroke={C.ink} stroke-width="3.2" />
    </g>
  )}

  {/* 5. BOOKS — Tumpukan Buku Biru & Kuning Khas Saki (Props #5 di saki.png) */}
  {name === 'books' && (
    <g>
      <ellipse cx="32" cy="55" rx="24" ry="4" fill="rgba(35,31,37,0.14)" />
      {/* Buku Bawah (Kuning) */}
      <path
        d="M 10 36 L 48 33 L 54 41 L 54 49 L 16 52 L 10 44 Z"
        fill={C.yellow}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path d="M 14 42 L 51 39 L 51 46 L 14 49 Z" fill="#FFFDF7" stroke={C.ink} stroke-width="2.4" stroke-linejoin="round" />
      {/* Buku Atas (Biru) */}
      <path
        d="M 12 20 L 46 16 L 52 24 L 52 32 L 18 36 L 12 28 Z"
        fill={C.blueDark}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path d="M 16 26 L 49 22 L 49 29 L 16 33 Z" fill="#FFFDF7" stroke={C.ink} stroke-width="2.4" stroke-linejoin="round" />
    </g>
  )}

  {/* 6. COFFEE — Mug Kopi Putih Berasap Khas Saki (Props #6 di saki.png) */}
  {name === 'coffee' && (
    <g>
      <ellipse cx="30" cy="55" rx="18" ry="4" fill="rgba(35,31,37,0.14)" />
      <path d="M 22 10 Q 24 15 22 20 M 30 8 Q 32 14 30 20 M 38 11 Q 40 16 38 20" fill="none" stroke={C.leather} stroke-width="2.6" stroke-linecap="round" />
      <path d="M 42 30 C 52 30, 52 44, 42 44" fill="none" stroke={C.ink} stroke-width="3.4" stroke-linecap="round" />
      <rect x="14" y="24" width="28" height="26" rx="7" fill="#FFFFFF" stroke={C.ink} stroke-width="3.2" />
      <ellipse cx="28" cy="27" rx="11" ry="3.5" fill={C.leather} stroke={C.ink} stroke-width="2.4" />
    </g>
  )}

  {/* 7. PLANT — Tanaman Tunas di Pot Krem Khas Saki (Props #7 di saki.png) */}
  {name === 'plant' && (
    <g>
      <ellipse cx="32" cy="56" rx="16" ry="3.5" fill="rgba(35,31,37,0.14)" />
      {/* Daun Kiri & Kanan */}
      <path
        d="M 32 28 C 30 16, 18 10, 12 16 C 10 22, 20 30, 32 28 Z"
        fill={C.green}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path
        d="M 32 28 C 34 16, 46 10, 52 16 C 54 22, 44 30, 32 28 Z"
        fill="#A3B886"
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <line x1="32" y1="24" x2="32" y2="33" stroke={C.ink} stroke-width="3.2" stroke-linecap="round" />
      {/* Pot Terakota Krem */}
      <path d="M 19 37 L 45 37 L 41 53 L 23 53 Z" fill={C.peach} stroke={C.ink} stroke-width="3.2" stroke-linejoin="round" />
      <rect x="16" y="31" width="32" height="7" rx="2.5" fill={C.cream} stroke={C.ink} stroke-width="3.2" />
    </g>
  )}

  {/* 8. CHART — Papan Grafik Batang Kuning Khas Saki */}
  {name === 'chart' && (
    <g>
      <ellipse cx="32" cy="56" rx="22" ry="4" fill="rgba(35,31,37,0.14)" />
      <rect x="10" y="12" width="44" height="38" rx="6" fill="#FFFFFF" stroke={C.ink} stroke-width="3.2" />
      <rect x="18" y="31" width="6.5" height="12" rx="1.5" fill="#FDE08D" />
      <rect x="28.5" y="24" width="6.5" height="19" rx="1.5" fill={C.yellow} />
      <rect x="39" y="17" width="6.5" height="26" rx="1.5" fill={C.yellowDark} />
    </g>
  )}

  {/* 9. LIGHTBULB — Lampu Bohlam Ide Kuning Khas Saki */}
  {name === 'lightbulb' && (
    <g>
      <path
        d="M 32 6 L 32 11 M 14 14 L 18 18 M 50 14 L 46 18 M 8 30 L 13 30 M 56 30 L 51 30"
        stroke={C.yellow}
        stroke-width="3.2"
        stroke-linecap="round"
      />
      <path
        d="M 20 30 C 20 22, 25 16, 32 16 C 39 16, 44 22, 44 30 C 44 35, 40 39, 38 43 L 26 43 C 24 39, 20 35, 20 30 Z"
        fill="#FFF3B0"
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <rect x="25" y="43" width="14" height="8" rx="2.5" fill="#94A3B8" stroke={C.ink} stroke-width="3" />
    </g>
  )}

  {/* 10. MAGNIFIER — Kaca Pembesar Berlensa Biru Khas Saki */}
  {name === 'magnifier' && (
    <g>
      <rect x="36" y="34" width="8" height="20" rx="3.5" transform="rotate(-38 40 44)" fill={C.slate} stroke={C.ink} stroke-width="3.2" />
      <circle cx="27" cy="26" r="15" fill={C.slate} stroke={C.ink} stroke-width="3.2" />
      <circle cx="27" cy="26" r="10.5" fill={C.blue} stroke={C.ink} stroke-width="2.6" />
      <path d="M 21 31 L 28 19 L 31 20 L 24 32 Z" fill="#FFFFFF" opacity="0.88" />
    </g>
  )}

  {/* 11. HEADPHONES — Headphone Hijau Sage & Not Musik Khas Saki */}
  {name === 'headphones' && (
    <g>
      <path d="M 14 36 C 14 14, 50 14, 50 36" fill="none" stroke={C.ink} stroke-width="4" stroke-linecap="round" />
      <ellipse cx="14" cy="39" rx="7" ry="11" fill={C.green} stroke={C.ink} stroke-width="3.2" />
      <ellipse cx="50" cy="39" rx="7" ry="11" fill={C.green} stroke={C.ink} stroke-width="3.2" />
      <path d="M 28 38 L 30 24 L 40 26 L 38 40" fill="none" stroke={C.yellow} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="26.5" cy="38" r="2.8" fill={C.yellow} />
      <circle cx="36.5" cy="40" r="2.8" fill={C.yellow} />
    </g>
  )}

  {/* 12. OPEN-BOOK — Buku Catatan Hijau Terbuka (Pose Reading) */}
  {name === 'open-book' && (
    <g>
      <ellipse cx="32" cy="55" rx="22" ry="4" fill="rgba(35,31,37,0.14)" />
      <path
        d="M 10 20 L 32 26 L 54 20 L 51 46 L 32 51 L 13 46 Z"
        fill="#FFFDF7"
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path
        d="M 12 24 L 32 30 L 52 24 L 49 49 L 32 53 L 15 49 Z"
        fill={C.green}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <line x1="32" y1="30" x2="32" y2="53" stroke={C.ink} stroke-width="3" stroke-linecap="round" />
      <path d="M 18 33 L 27 35 M 18 39 L 26 41 M 37 35 L 46 33 M 38 41 L 46 39" stroke="#FFFDF7" stroke-width="2.4" stroke-linecap="round" opacity="0.8" />
    </g>
  )}

  {/* 13. DATABASE — Silinder Database Relasional Berlapis */}
  {name === 'database' && (
    <g>
      <ellipse cx="32" cy="56" rx="20" ry="3.5" fill="rgba(35,31,37,0.14)" />
      <path
        d="M 14 36 L 14 46 C 14 50.5, 22 53, 32 53 C 42 53, 50 50.5, 50 46 L 50 36 Z"
        fill={C.blueDark}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path
        d="M 14 25 L 14 36 C 14 40.5, 22 43, 32 43 C 42 43, 50 40.5, 50 36 L 50 25 Z"
        fill={C.blue}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path
        d="M 14 16 L 14 25 C 14 29.5, 22 32, 32 32 C 42 32, 50 29.5, 50 25 L 50 16 Z"
        fill={C.cream}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <ellipse cx="32" cy="16" rx="18" ry="6" fill={C.yellow} stroke={C.ink} stroke-width="3.2" />
      <circle cx="42" cy="26.5" r="2" fill={C.ink} />
      <circle cx="42" cy="37.5" r="2" fill={C.yellow} />
      <circle cx="42" cy="47.5" r="2" fill={C.cream} />
    </g>
  )}

  {/* 14. CODE-TERMINAL — Jendela Terminal Kode </> */}
  {name === 'code-terminal' && (
    <g>
      <ellipse cx="32" cy="55" rx="22" ry="4" fill="rgba(35,31,37,0.14)" />
      <rect x="9" y="13" width="46" height="38" rx="7" fill={C.slate} stroke={C.ink} stroke-width="3.2" />
      <path d="M 9 20 C 9 16, 12 13, 16 13 L 48 13 C 52 13, 55 16, 55 20 L 55 23 L 9 23 Z" fill={C.cream} stroke={C.ink} stroke-width="3.2" />
      <circle cx="15.5" cy="18" r="2" fill="#FA9068" />
      <circle cx="21.5" cy="18" r="2" fill={C.yellow} />
      <circle cx="27.5" cy="18" r="2" fill={C.green} />
      <path d="M 18 32 L 24 37 L 18 42" fill="none" stroke={C.yellow} stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
      <line x1="28" y1="42" x2="38" y2="42" stroke={C.blue} stroke-width="3.2" stroke-linecap="round" />
    </g>
  )}

  {/* 15. AI-SPARK — Node Otomasi AI & Multi-Agent */}
  {name === 'ai-spark' && (
    <g>
      <ellipse cx="32" cy="56" rx="18" ry="3.5" fill="rgba(35,31,37,0.14)" />
      <line x1="16" y1="18" x2="48" y2="46" stroke={C.ink} stroke-width="3" stroke-linecap="round" />
      <line x1="48" y1="18" x2="16" y2="46" stroke={C.ink} stroke-width="3" stroke-linecap="round" />
      <circle cx="15" cy="17" r="5" fill={C.blue} stroke={C.ink} stroke-width="2.8" />
      <circle cx="49" cy="17" r="5" fill={C.green} stroke={C.ink} stroke-width="2.8" />
      <circle cx="15" cy="47" r="5" fill={C.peach} stroke={C.ink} stroke-width="2.8" />
      <circle cx="49" cy="47" r="5" fill={C.blue} stroke={C.ink} stroke-width="2.8" />
      <path
        d="M 32 13 C 34 24, 40 30, 51 32 C 40 34, 34 40, 32 51 C 30 40, 24 34, 13 32 C 24 30, 30 24, 32 13 Z"
        fill={C.yellow}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <circle cx="32" cy="32" r="3.5" fill="#FFFFFF" />
    </g>
  )}

  {/* 16. TROPHY — Piala Penghargaan Emas */}
  {name === 'trophy' && (
    <g>
      <ellipse cx="32" cy="56" rx="18" ry="3.5" fill="rgba(35,31,37,0.14)" />
      <path d="M 18 18 C 10 18, 10 31, 19 32" fill="none" stroke={C.ink} stroke-width="3.2" stroke-linecap="round" />
      <path d="M 46 18 C 54 18, 54 31, 45 32" fill="none" stroke={C.ink} stroke-width="3.2" stroke-linecap="round" />
      <path
        d="M 18 14 L 46 14 L 44 29 C 43 37, 38 41, 32 41 C 26 41, 21 37, 20 29 Z"
        fill={C.yellow}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <rect x="29" y="41" width="6" height="7" fill={C.yellowDark} stroke={C.ink} stroke-width="3" />
      <rect x="21" y="48" width="22" height="6" rx="2.5" fill={C.leather} stroke={C.ink} stroke-width="3.2" />
      <path d="M 32 20 L 33.8 24 L 38 24.4 L 34.8 27.2 L 35.8 31.2 L 32 29 L 28.2 31.2 L 29.2 27.2 L 26 24.4 L 30.2 24 Z" fill="#FFFDF7" />
    </g>
  )}

  {/* 17. COMPASS — Kompas Navigasi Penjelajah */}
  {name === 'compass' && (
    <g>
      <ellipse cx="32" cy="56" rx="19" ry="3.5" fill="rgba(35,31,37,0.14)" />
      <circle cx="32" cy="32" r="21" fill={C.leather} stroke={C.ink} stroke-width="3.2" />
      <circle cx="32" cy="32" r="16" fill={C.cream} stroke={C.ink} stroke-width="2.8" />
      <polygon points="32,19 37,32 32,29 27,32" fill="#FA9068" stroke={C.ink} stroke-width="2.2" stroke-linejoin="round" />
      <polygon points="32,45 37,32 32,35 27,32" fill={C.slate} stroke={C.ink} stroke-width="2.2" stroke-linejoin="round" />
      <circle cx="32" cy="32" r="2.8" fill={C.yellow} stroke={C.ink} stroke-width="2" />
    </g>
  )}

  {/* 18. ROCKET — Roket Peluncuran Sistem */}
  {name === 'rocket' && (
    <g>
      <ellipse cx="32" cy="56" rx="16" ry="3.5" fill="rgba(35,31,37,0.14)" />
      <path d="M 27 44 C 27 51, 32 55, 32 55 C 32 55, 37 51, 37 44 Z" fill={C.yellow} stroke={C.ink} stroke-width="2.8" stroke-linejoin="round" />
      <path d="M 22 33 L 14 42 L 23 42 Z" fill={C.green} stroke={C.ink} stroke-width="3" stroke-linejoin="round" />
      <path d="M 42 33 L 50 42 L 41 42 Z" fill={C.green} stroke={C.ink} stroke-width="3" stroke-linejoin="round" />
      <path
        d="M 32 9 C 23 17, 21 29, 22 43 L 42 43 C 43 29, 41 17, 32 9 Z"
        fill={C.cream}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path d="M 32 9 C 27 14, 25 19, 24 22 L 40 22 C 39 19, 37 14, 32 9 Z" fill={C.yellow} stroke={C.ink} stroke-width="3" stroke-linejoin="round" />
      <circle cx="32" cy="31" r="5.5" fill={C.blue} stroke={C.ink} stroke-width="2.8" />
    </g>
  )}

  {/* 19. PUZZLE — Kepingan Puzzle Solusi Arsitektur */}
  {name === 'puzzle' && (
    <g>
      <ellipse cx="32" cy="56" rx="18" ry="3.5" fill="rgba(35,31,37,0.14)" />
      <path
        d="M 16 18 L 28 18 C 28 13, 36 13, 36 18 L 48 18 L 48 30 C 53 30, 53 38, 48 38 L 48 48 L 36 48 C 36 43, 28 43, 28 48 L 16 48 L 16 38 C 21 38, 21 30, 16 30 Z"
        fill={C.yellow}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <circle cx="32" cy="28" r="2.5" fill="#FFFDF7" opacity="0.85" />
    </g>
  )}

  {/* 20. SHIELD — Perisai Keamanan & Strategi Fallback */}
  {name === 'shield' && (
    <g>
      <ellipse cx="32" cy="56" rx="16" ry="3.5" fill="rgba(35,31,37,0.14)" />
      <path
        d="M 32 10 L 50 17 L 50 31 C 50 43, 41 50, 32 53 C 23 50, 14 43, 14 31 L 14 17 Z"
        fill={C.green}
        stroke={C.ink}
        stroke-width="3.2"
        stroke-linejoin="round"
      />
      <path
        d="M 32 15 L 45 20 L 45 31 C 45 40, 38 45, 32 48 C 26 45, 19 40, 19 31 L 19 20 Z"
        fill={C.cream}
        stroke={C.ink}
        stroke-width="2.6"
        stroke-linejoin="round"
      />
      <path d="M 25 31 L 30 36 L 39 26" fill="none" stroke={C.ink} stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
</svg>
