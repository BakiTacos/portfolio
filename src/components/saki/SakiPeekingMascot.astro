---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}

const {
  class: className = '',
  width = 165,
  height = 115,
} = Astro.props;

const uid = 'saki-peek-' + Math.random().toString(36).substring(2, 9);
const creamGrad = `url(#${uid}-cream)`;
const leatherGrad = `url(#${uid}-leather)`;
const lensGrad = `url(#${uid}-lens)`;
---

<svg
  viewBox="24 4 228 164"
  width={width}
  height={height}
  role="img"
  aria-label="Saki Mascot Peeking Over Folder"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id={`${uid}-cream`} cx="48%" cy="35%" r="72%">
      <stop offset="0%" stop-color="#FFFDF9" />
      <stop offset="68%" stop-color="#FEF7EE" />
      <stop offset="100%" stop-color="#FDE2C8" />
    </radialGradient>

    <linearGradient id={`${uid}-leather`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#AA7E70" />
      <stop offset="55%" stop-color="#8D6458" />
      <stop offset="100%" stop-color="#6E4B40" />
    </linearGradient>

    <linearGradient id={`${uid}-lens`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#CDE9F6" />
      <stop offset="55%" stop-color="#A6D2E6" />
      <stop offset="100%" stop-color="#86B9D2" />
    </linearGradient>

    {/* Clipping agar bagian bawah kepala menyatu rapi di balik bibir atas folder (y=152) */}
    <clipPath id={`${uid}-folder-edge`}>
      <rect x="0" y="0" width="260" height="152" />
    </clipPath>
  </defs>

  {/* =====================================================================
      1. 3 BERKAS SINAR KUNING CERAH DI KANAN ATAS
      ===================================================================== */}
  <g>
    <path
      d="M 196 34 C 194 29, 198 24, 204 25 C 209 26, 212 30, 211 36 L 207 52 C 206 57, 201 59, 197 58 C 193 57, 191 53, 192 48 Z"
      fill="#FECD5E"
    />
    <path
      d="M 218 48 C 216 44, 220 39, 226 39 C 231 39, 235 43, 233 48 L 222 64 C 219 68, 214 69, 210 67 C 207 65, 207 60, 210 56 Z"
      fill="#FECD5E"
    />
    <path
      d="M 226 74 C 226 69, 230 65, 236 65 C 241 65, 245 69, 243 74 L 230 83 C 225 86, 220 84, 219 81 C 218 77, 221 74, 226 74 Z"
      fill="#FECD5E"
    />
  </g>

  {/* =====================================================================
      2. KEPALA MOCHI, WAJAH & GOGGLE (Terpotong Bibir Folder)
      ===================================================================== */}
  <g clip-path={`url(#${uid}-folder-edge)`}>
    {/* Kepala Mochi & Pipi Gembil */}
    <path
      d="M 88 60 C 120 52, 172 64, 188 110 L 190 126 C 198 128, 204 134, 203 142 C 202 150, 192 156, 178 158 C 144 166, 96 166, 62 158 C 48 156, 38 150, 37 142 C 36 134, 42 128, 50 126 L 52 110 C 64 76, 80 62, 88 60 Z"
      fill={creamGrad}
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linejoin="round"
    />

    {/* Jambul Swirl di Atas Kepala */}
    <path
      d="M 88 62 C 82 44, 86 26, 102 18 C 118 11, 134 17, 139 30 C 141 34, 138 36, 133 37 C 125 39, 120 45, 119 52 L 122 64 Z"
      fill={creamGrad}
    />
    <path
      d="M 88 58 C 82 42, 86 26, 102 18 C 118 11, 134 17, 139 30 C 141 34, 138 36, 133 37 C 125 39, 120 45, 119 51"
      fill="none"
      stroke="#231F25"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    {/* Rona Pipi Peach */}
    <ellipse cx="76" cy="138" rx="13" ry="8" fill="#FDD5B8" />
    <ellipse cx="164" cy="138" rx="13" ry="8" fill="#FDD5B8" />

    {/* Mata Kiri Kedip '>' & Mata Kanan Bulat Berbinar */}
    <path
      d="M 86 117 L 99 124 L 86 131"
      fill="none"
      stroke="#231F25"
      stroke-width="4.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <ellipse cx="147" cy="124" rx="6.5" ry="9.5" fill="#231F25" />
    <ellipse cx="145.2" cy="120" rx="2.1" ry="2.7" fill="#FFFFFF" />

    {/* Hidung Kecil */}
    <ellipse cx="120" cy="127" rx="2.5" ry="1.5" fill="#F29A76" />

    {/* Mulut Ceria Terbuka & Lidah */}
    <g>
      <path
        d="M 110 131 Q 116 132 120 128 Q 124 132 130 131 C 132 141, 129 151, 120 151 C 111 151, 108 141, 110 131 Z"
        fill="#86432D"
        stroke="#231F25"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <path
        d="M 112 140 C 116 135, 124 135, 128 140 C 126 146, 123 149, 120 149 C 117 149, 114 146, 112 140 Z"
        fill="#FA9068"
      />
      <path
        d="M 110 131 Q 116 132 120 128 Q 124 132 130 131 C 132 141, 129 151, 120 151 C 111 151, 108 141, 110 131 Z"
        fill="none"
        stroke="#231F25"
        stroke-width="3"
        stroke-linejoin="round"
      />
    </g>

    {/* Kacamata Goggle Aviator 3-Lapis */}
    <path
      d="M 48 124 C 48 106, 56 92, 68 82 L 76 92 C 66 102, 56 114, 50 126 Z"
      fill={leatherGrad}
      stroke="#231F25"
      stroke-width="4.2"
      stroke-linejoin="round"
    />
    <path
      d="M 192 124 C 192 106, 184 92, 172 82 L 164 92 C 174 102, 184 114, 190 126 Z"
      fill={leatherGrad}
      stroke="#231F25"
      stroke-width="4.2"
      stroke-linejoin="round"
    />
    <rect x="111" y="70" width="18" height="14" rx="3" fill={leatherGrad} stroke="#231F25" stroke-width="4.2" />

    <g transform="translate(89 78) rotate(-12)">
      <ellipse cx="0" cy="3" rx="24" ry="19" fill={leatherGrad} stroke="#231F25" stroke-width="4.5" />
      <ellipse cx="0" cy="-2" rx="22" ry="16" fill="#785247" stroke="#231F25" stroke-width="3.8" />
      <ellipse cx="0" cy="-2" rx="18" ry="12.5" fill={lensGrad} stroke="#231F25" stroke-width="3.2" />
      <path d="M -11 6 L -2 -12 L 4 -12 L -5 8 Z" fill="#FFFFFF" opacity="0.88" />
      <path d="M -2 8 L 7 -10 L 10 -9 L 1 9 Z" fill="#FFFFFF" opacity="0.65" />
    </g>

    <g transform="translate(151 78) rotate(12)">
      <ellipse cx="0" cy="3" rx="24" ry="19" fill={leatherGrad} stroke="#231F25" stroke-width="4.5" />
      <ellipse cx="0" cy="-2" rx="22" ry="16" fill="#785247" stroke="#231F25" stroke-width="3.8" />
      <ellipse cx="0" cy="-2" rx="18" ry="12.5" fill={lensGrad} stroke="#231F25" stroke-width="3.2" />
      <path d="M -11 6 L -2 -12 L 4 -12 L -5 8 Z" fill="#FFFFFF" opacity="0.88" />
      <path d="M -2 8 L 7 -10 L 10 -9 L 1 9 Z" fill="#FFFFFF" opacity="0.65" />
    </g>
  </g>

  {/* =====================================================================
      3. TANGAN BULAT MOCHI MENGGANTUNG DI ATAS BIBIR FOLDER
      ===================================================================== */}
  {/* Bayangan halus cakar pada rim folder */}
  <ellipse
    cx="174"
    cy="153"
    rx="21"
    ry="13"
    transform="rotate(6 174 153)"
    fill="#5A4518"
    opacity="0.16"
  />
  <ellipse
    cx="174"
    cy="150"
    rx="20"
    ry="13.5"
    transform="rotate(6 174 150)"
    fill={creamGrad}
    stroke="#231F25"
    stroke-width="4.5"
  />
</svg>
