<script>
  function initSakiDetailPlate() {
    const slides = document.querySelectorAll<HTMLElement>(".mockup-slide-item");
    const dots = document.querySelectorAll<HTMLButtonElement>(".mockup-dot");
    const captionEl = document.getElementById("mockup-active-caption");
    const counterEl = document.getElementById("mockup-slide-counter");
    const prevBtn = document.getElementById("mockup-prev-btn");
    const nextBtn = document.getElementById("mockup-next-btn");
    const thumbCards = document.querySelectorAll<HTMLButtonElement>("[data-jump-slide]");

    let currentIdx = 0;
    const total = slides.length;

    function showSlide(index: number) {
      if (total === 0) return;
      currentIdx = (index + total) % total;
      slides.forEach((s, i) => {
        s.classList.toggle("is-active", i === currentIdx);
      });
      dots.forEach((d, i) => {
        d.classList.toggle("is-active", i === currentIdx);
      });
      const activeSlide = slides[currentIdx];
      if (captionEl && activeSlide) {
        captionEl.textContent = activeSlide.dataset.slideCaption || "";
      }
      if (counterEl) {
        counterEl.textContent = `${currentIdx + 1} / ${total}`;
      }
    }

    prevBtn?.addEventListener("click", () => showSlide(currentIdx - 1));
    nextBtn?.addEventListener("click", () => showSlide(currentIdx + 1));

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const target = Number(dot.dataset.targetSlide || 0);
        showSlide(target);
      });
    });

    thumbCards.forEach((card) => {
      card.addEventListener("click", () => {
        const target = Number(card.dataset.jumpSlide || 0);
        showSlide(target);
        document.getElementById("detail-mockup-carousel")?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });

    // Interactive Tabs Filtering
    const tabBtns = document.querySelectorAll<HTMLButtonElement>("[data-detail-tab]");
    const overviewSec = document.querySelector<HTMLElement>(".overview-section");
    const iterationCards = document.querySelectorAll<HTMLElement>(".iteration-card");
    const lessonsSections = document.querySelectorAll<HTMLElement>(".lessons-section");
    const galleryPanel = document.getElementById("detail-gallery-panel");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = btn.dataset.detailTab || "overview";
        tabBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-selected", active ? "true" : "false");
        });

        // Reset visibility
        if (galleryPanel) {
          galleryPanel.classList.toggle("is-hidden", tab !== "gallery");
        }

        if (tab === "overview") {
          if (overviewSec) overviewSec.style.display = "";
          iterationCards.forEach((c) => (c.style.display = ""));
          lessonsSections.forEach((l) => (l.style.display = ""));
        } else if (tab === "process") {
          if (overviewSec) overviewSec.style.display = "none";
          iterationCards.forEach((c, idx) => {
            const isProcessCard =
              iterationCards.length <= 2 ||
              idx === 0 ||
              idx === iterationCards.length - 1;
            c.style.display = isProcessCard ? "" : "none";
          });
          lessonsSections.forEach((l) => (l.style.display = "none"));
        } else if (tab === "features") {
          if (overviewSec) overviewSec.style.display = "none";
          iterationCards.forEach((c, idx) => {
            const isFeatureCard =
              iterationCards.length <= 2 ||
              (idx > 0 && idx < iterationCards.length);
            c.style.display = isFeatureCard ? "" : "none";
          });
          lessonsSections.forEach((l) => (l.style.display = "none"));
        } else if (tab === "gallery") {
          if (overviewSec) overviewSec.style.display = "none";
          iterationCards.forEach((c) => (c.style.display = "none"));
          lessonsSections.forEach((l) => (l.style.display = "none"));
        } else if (tab === "takeaways") {
          if (overviewSec) overviewSec.style.display = "none";
          iterationCards.forEach((c) => (c.style.display = "none"));
          lessonsSections.forEach((l) => (l.style.display = ""));
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initSakiDetailPlate);
  document.addEventListener("astro:page-load", initSakiDetailPlate);
</script>

