---
import CallToAction from "../CallToAction.astro";

interface SpecItem {
	label: string;
	value: string;
	highlight?: boolean;
}

interface Props {
	title: string;
	subtitle?: string;
	tag: string;
	awardText?: string;
	awardIcon?: string;
	specs?: SpecItem[];
	demoUrl?: string;
	githubUrl?: string;
	videoUrl?: string;
	backUrl?: string;
}

const {
	title,
	subtitle,
	tag,
	specs,
	demoUrl,
	githubUrl,
	videoUrl,
	backUrl = "/#work-hero"
} = Astro.props;
---

<header class="tech-spec-plate">
	<!-- Top Navigation Breadcrumb -->
	<div class="plate-top-bar">
		<a href={backUrl} class="back-link fl-mono">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M19 12H5M12 19l-7-7 7-7"/>
			</svg>
			<span>Back to Works</span>
		</a>
		<div class="plate-tag-badge fl-mono">
			<span>{tag}</span>
		</div>
	</div>

	<!-- Main Title & Tagline -->
	<div class="plate-title-group">
		<h1 class="plate-main-title">{title}</h1>
		{subtitle && <p class="plate-subtitle">{subtitle}</p>}
	</div>

	<!-- Farline-Inspired Technical Specifications Grid -->
	{specs && specs.length > 0 && (
		<div class="plate-specs-grid">
			{specs.map((item, idx) => (
				<div class="spec-cell">
					<div class="spec-cell-header fl-mono">
						<span class="spec-index">0{idx + 1}</span>
						<span class="spec-label">{item.label}</span>
					</div>
					<div class:list={["spec-cell-value", { "is-highlight": item.highlight }]}>
						{item.value}
					</div>
				</div>
			))}
		</div>
	)}

	<!-- Quick Action Links -->
	{(demoUrl || githubUrl || videoUrl) && (
		<div class="plate-actions-bar">
			{demoUrl && (
				<CallToAction href={demoUrl} target="_blank">
					Live Demo ↗
				</CallToAction>
			)}
			{githubUrl && (
				<CallToAction href={githubUrl} target="_blank">
					GitHub Repo ↗
				</CallToAction>
			)}
			{videoUrl && (
				<CallToAction href={videoUrl} target="_blank">
					Motion Graphic ↗
				</CallToAction>
			)}
		</div>
	)}
</header>

<style lang="scss">
	.tech-spec-plate {
		position: relative;
		width: 100%;
		padding: 2.5rem 0 3rem;
		border-bottom: 1px solid var(--farline-hairline);
		margin-bottom: 2.5rem;
	}

	.plate-top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			color: var(--farline-text-muted);
			text-decoration: none;
			font-size: 0.75rem;
			transition: color 0.2s ease, transform 0.2s ease;

			&:hover {
				color: var(--farline-text-primary);
				transform: translateX(-3px);
			}
		}

		.plate-tag-badge {
			padding: 4px 10px;
			background: var(--farline-surface-muted);
			border: 1px solid var(--farline-border);
			border-radius: 9999px;
			color: var(--farline-text-secondary);
			font-size: 0.72rem;
		}
	}

	.plate-title-group {
		margin-bottom: 2rem;

		.plate-main-title {
			font-size: clamp(2rem, 4.5vw, 3.2rem);
			font-weight: 700;
			color: var(--farline-text-primary);
			line-height: 1.15;
			letter-spacing: -0.03em;
			margin: 0;
		}

		.plate-subtitle {
			font-size: 1.1rem;
			color: var(--farline-text-secondary);
			margin: 12px 0 0;
			line-height: 1.5;
			max-width: 800px;
		}
	}

	/* Specifications Grid */
	.plate-specs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1px;
		background: var(--farline-hairline);
		border: 1px solid var(--farline-hairline);
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 2rem;
	}

	.spec-cell {
		background: var(--farline-surface);
		padding: 16px 18px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		transition: background-color 0.2s ease;

		&:hover {
			background: var(--farline-surface-muted);
		}

		.spec-cell-header {
			display: flex;
			align-items: center;
			gap: 8px;
			color: var(--farline-text-muted);
			font-size: 0.68rem;

			.spec-index {
				opacity: 0.6;
			}
		}

		.spec-cell-value {
			font-size: 0.92rem;
			font-weight: 500;
			color: var(--farline-text-primary);
			line-height: 1.4;

			&.is-highlight {
				color: #3b82f6;
				font-weight: 600;
			}
		}
	}

	.plate-actions-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	@media (max-width: 640px) {
		.plate-specs-grid {
			grid-template-columns: 1fr;
		}

		.plate-actions-bar {
			flex-direction: column;
			width: 100%;

			:global(.btn) {
				width: 100%;
				text-align: center;
			}
		}
	}
</style>
