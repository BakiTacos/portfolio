---
import { Image } from "astro:assets";
import SakiLaptopHero from "../saki/SakiLaptopHero.astro";
import SakiPeekingMascot from "../saki/SakiPeekingMascot.astro";
import SakiPropElement from "../saki/SakiPropElement.astro";
import { PROJECT_SAKI_MAP, type SakiGraphicMood, type SakiPropName } from "../saki/sakiMoods";

// Import all project gallery slides for the interactive Browser Mockup Carousel
import bkCover from "../../assets/projects/bookkeeping/cover.png";
import bkStart from "../../assets/projects/bookkeeping/start.png";
import bkV1 from "../../assets/projects/bookkeeping/v1.png";
import bkV2 from "../../assets/projects/bookkeeping/v2.png";
import bkV3 from "../../assets/projects/bookkeeping/v3.png";

import buCover from "../../assets/projects/bridgeu/bridgeu-cover.png";
import buCollab from "../../assets/projects/bridgeu/collaborate.png";
import buTracker from "../../assets/projects/bridgeu/portfolio-tracker.png";
import buProfile from "../../assets/projects/bridgeu/profile.png";
import buCert from "../../assets/projects/bridgeu/e_certificate.jpg";

import dtCover from "../../assets/projects/dapurtwin/cover-dapurtwin.png";
import dtOverview from "../../assets/projects/dapurtwin/overview.png";
import dtResep from "../../assets/projects/dapurtwin/menu_resep.png";
import dtPesanan from "../../assets/projects/dapurtwin/proses_pesanan.png";
import dtBahan from "../../assets/projects/dapurtwin/kondisi_bahan.png";
import dtLaporan from "../../assets/projects/dapurtwin/laporan.png";

import tkCover from "../../assets/projects/tukangin/tukangin-cover.png";
import tkHome from "../../assets/projects/tukangin/home.png";
import tkLayanan from "../../assets/projects/tukangin/layanan.png";
import tkTeknisi from "../../assets/projects/tukangin/teknisi.png";
import tkProfile from "../../assets/projects/tukangin/profile.png";

import spCover from "../../assets/projects/suparta/suparta-cover.webp";
import spHome from "../../assets/projects/suparta/home.webp";
import spProject from "../../assets/projects/suparta/project.webp";
import spStory from "../../assets/projects/suparta/story.webp";

import ssCover from "../../assets/projects/studentsupport/studsop-cover.webp";
import ssHome from "../../assets/projects/studentsupport/home.webp";
import ssSection from "../../assets/projects/studentsupport/home-section.webp";
import ssFooter from "../../assets/projects/studentsupport/footer.webp";

import flStart from "../../assets/projects/penerbangan/start.webp";
import flPredict from "../../assets/projects/penerbangan/predict.webp";

import isCover from "../../assets/projects/isfest/cover.webp";
import isHome from "../../assets/projects/isfest/home.webp";
import isArena from "../../assets/projects/isfest/arena.webp";
import isLogin from "../../assets/projects/isfest/login.webp";

import n8nCover from "../../assets/projects/n8n-orchestra/orchestra.webp";
import n8nCanvas from "../../assets/projects/n8n-orchestra/n8n-image.webp";
import n8nBi from "../../assets/projects/n8n-orchestra/workflow-bi.webp";
import n8nSocial from "../../assets/projects/n8n-orchestra/workflow-social-media.webp";
import n8nMkt from "../../assets/projects/n8n-orchestra/workflow-marketing.webp";
import n8nContent from "../../assets/projects/n8n-orchestra/workflow-content-idea.webp";
import n8nLib from "../../assets/projects/n8n-orchestra/workflow-library.webp";

interface SpecItem {
  label: string;
  value: string;
  highlight?: boolean;
}

interface Props {
  title: string;
  subtitle?: string;
  tag: string;
  awardText?: string;
  awardIcon?: string;
  sakiMood?: SakiGraphicMood;
  sakiProp?: SakiPropName;
  specs?: SpecItem[];
  demoUrl?: string;
  githubUrl?: string;
  videoUrl?: string;
  videoLabel?: string;
  backUrl?: string;
}

interface SlideItem {
  img: ImageMetadata;
  caption: string;
}

interface ProjectMetaConfig {
  subtitle: string;
  overviewText: string;
  role: string;
  techStack: string[];
  duration: string;
  team: string;
  slides: SlideItem[];
}

const PROJECT_DETAIL_CONFIG: Record<string, ProjectMetaConfig> = {
  bookkeeping: {
    subtitle: "Transactions, Inventory & Multi-Level Accounts",
    overviewText:
      "A web-based bookkeeping and financial management system engineered across four architectural iterations to record transactions, manage inventory, and generate multi-level financial reports accurately.",
    role: "Full-Stack & Data Architect",
    techStack: ["Next.js", "PostgreSQL", "Firebase", "Excel"],
    duration: "4-Stage Evolution (Excel → V3)",
    team: "Solo Engineering Project",
    slides: [
      { img: bkCover, caption: "Bookkeeping & Financial System — Multi-Level Accounts Overview" },
      { img: bkV3, caption: "V3 Architecture — PostgreSQL Relational Schema & Drill-Down Reports" },
      { img: bkV2, caption: "V2 Iteration — Connected Financial Workflow & Query Analysis" },
      { img: bkV1, caption: "V1 Foundation — Initial Next.js & Firebase Bookkeeping UI" },
      { img: bkStart, caption: "Starting Point — Microsoft Excel Transaction Ledger" },
    ],
  },
  bridgeu: {
    subtitle: "Academic Collaboration & Automated Verified Portfolios",
    overviewText:
      "An award-winning university and industry collaboration platform enabling students to discover verified company case studies via weighted recommendations and automatically compile authenticated portfolios.",
    role: "Backend, DB & Algorithm Lead",
    techStack: ["Next.js", "Supabase", "PostgreSQL"],
    duration: "UBM Inspire 1.0 Competition",
    team: "Team Project (Juara 2 🏆)",
    slides: [
      { img: buCover, caption: "BridgeU — University & Industry Collaboration Platform" },
      { img: buCollab, caption: "Verified Companies & Weighted Opportunity Recommendation Engine" },
      { img: buTracker, caption: "Automated Track Record & Verified Portfolio Generation" },
      { img: buProfile, caption: "Student Profile & Gamified Achievement Badges" },
      { img: buCert, caption: "2nd Place Winner (Juara 2) — UBM Inspire 1.0 Certificate" },
    ],
  },
  dapurtwin: {
    subtitle: "Smart Recipe BOM, Dynamic HPP & Real-Time Kitchen Display System",
    overviewText:
      "A full-stack F&B operational and POS SaaS bridging table QR ordering with atomic kitchen inventory deduction, unit-normalized Recipe BOM, real-time KDS, and automated HPP margin tracking.",
    role: "System & BOM Engine Architect",
    techStack: ["Next.js", "Supabase", "PostgreSQL", "AI OCR"],
    duration: "Fullstack F&B POS & KDS SaaS",
    team: "Tim Lotus Biru (3 Members)",
    slides: [
      { img: dtCover, caption: "DapurTwin — Fullstack F&B Operational & POS SaaS" },
      { img: dtOverview, caption: "Operational Command Center & Ingredient Readiness Radar" },
      { img: dtResep, caption: "Smart Recipe BOM & Dynamic HPP Gross Margin Calculator" },
      { img: dtPesanan, caption: "Kitchen Display System (KDS) & Live Recipe Stock Check" },
      { img: dtBahan, caption: "Freshness & Shelf-Life FIFO Inventory Condition Tracker" },
      { img: dtLaporan, caption: "Interactive Financial Analytics & Catering Business Simulation" },
    ],
  },
  tukangin: {
    subtitle: "Early-Stage Laravel Monolith, Relational Database & Heuristic Matching",
    overviewText:
      "An on-demand home service and technician marketplace built on Laravel MVC and MySQL, exploring relational schema design, N+1 query optimization, and location-plus-schedule matching heuristics.",
    role: "Full-Stack Laravel Developer",
    techStack: ["Laravel", "PHP", "MySQL", "Blade"],
    duration: "Monolith MVC & Query Audit",
    team: "Team Engineering Project",
    slides: [
      { img: tkCover, caption: "Tukang.in — On-Demand Home Service & Technician Marketplace" },
      { img: tkHome, caption: "Customer Portal & Quick Service Category Discovery" },
      { img: tkLayanan, caption: "Structured Service Directory & Standardized Work Scope" },
      { img: tkTeknisi, caption: "Verified Technician Partner Directory & Filtering" },
      { img: tkProfile, caption: "Customer Booking Lifecycle & Account Management" },
    ],
  },
  suparta: {
    subtitle: "Official Brand Platform, Bilingual Architecture & High-Ticket Sales Conversion",
    overviewText:
      "A luxury brand platform and bilingual sales enablement system for SUPARTA automated mahjong tables, combining heritage storytelling, transparent hardware specs, and direct showroom conversion flows.",
    role: "Brand & Web Platform Developer",
    techStack: ["Next.js", "i18n Routing", "Tailwind"],
    duration: "Bilingual Brand & Sales System",
    team: "Brand Production Project",
    slides: [
      { img: spCover, caption: "SUPARTA — Luxury Automated Table & Smart Furniture Platform" },
      { img: spHome, caption: "Brand Building: Merging Cultural Heritage & Ultra-Silent Engineering" },
      { img: spProject, caption: "The Heritage Series Product Catalog & Transparent Hardware Specs" },
      { img: spStory, caption: "Sales Enablement: Digital Manual Library & Official Warranty Hub" },
    ],
  },
  studentsupport: {
    subtitle: "Fundamental Web Development, Early Database Modeling & Counseling Validation",
    overviewText:
      "My first web and database engineering project built from the ground up using semantic HTML5, CSS3, and JavaScript, validated through direct interviews with UMN Student Support counselors.",
    role: "Web Developer & User Researcher",
    techStack: ["HTML5", "CSS3", "JavaScript", "Relational DB"],
    duration: "First Codebase & Field Research",
    team: "University Foundation Project",
    slides: [
      { img: ssCover, caption: "Student Support UMN — Campus Mental Health & Accessibility Hub" },
      { img: ssHome, caption: "Inclusive Service Directory & Campus Accessibility Routes" },
      { img: ssSection, caption: "Verified Counselor Directory & Confidential Booking Flow" },
      { img: ssFooter, caption: "Emergency Crisis Channels & Student Request Status Tracker" },
    ],
  },
  penerbangan: {
    subtitle: "Big Data Processing, Advanced Feature Engineering & Streamlit Deployment",
    overviewText:
      "An end-to-end machine learning pipeline following the 6-stage CRISP-DM methodology on a 1.3 GB commercial flight dataset to predict departure delays using XGBoost and Streamlit.",
    role: "Data Analyst & ML Engineer",
    techStack: ["Python", "XGBoost", "Pandas", "Streamlit"],
    duration: "CRISP-DM Pipeline (1.3 GB Data)",
    team: "Data Analytics Project",
    slides: [
      { img: flStart, caption: "Streamlit Pre-Flight Parameter Configuration & Feature Pipeline" },
      { img: flPredict, caption: "XGBoost Delay Probability Inference & Operational Risk Breakdown" },
    ],
  },
  isfest: {
    subtitle: "Event Operations Platform, Graceful Fallback Mechanisms & Backblaze B2 Security",
    overviewText:
      "Production backend and interface engineering for ISFEST UMN 2026, implementing graceful API failover mechanisms, private Backblaze B2 object storage with pre-signed URLs, and cross-division workflows.",
    role: "Backend Engineer & UI/UX Guard",
    techStack: ["Backend API", "Backblaze B2", "S3 Protocol"],
    duration: "University Festival Production",
    team: "HIMSI UMN (ISFEST 2026)",
    slides: [
      { img: isCover, caption: "ISFEST UMN 2026 — The Grand Wizarding Conquest Platform" },
      { img: isHome, caption: "Event Landing Page & Graceful Degradation Registration Flow" },
      { img: isArena, caption: "Competition Arena & Private Backblaze B2 Document Isolation" },
      { img: isLogin, caption: "Participant Authentication & Cross-Division Verification Status" },
    ],
  },
  "n8n-orchestra": {
    subtitle: "Unified LangChain Agent in n8n Consolidating Fragmented Bots into Tool Calling",
    overviewText:
      "A unified multi-agent business assistant in n8n and LangChain that consolidates 5 specialized business workflows (Supabase BI, Social Analytics, Marketing Events, Content Strategy, and Script Library) into one Telegram interface.",
    role: "AI Automation & Workflow Architect",
    techStack: ["n8n", "LangChain", "Supabase", "Telegram"],
    duration: "Main Orchestrator + 5 Sub-Agents",
    team: "Internal Business AI System",
    slides: [
      { img: n8nCover, caption: "Telegram AI Orchestrator — Unified Multi-Agent Architecture" },
      { img: n8nCanvas, caption: "Full n8n Orchestrator Canvas with Window Memory & HTML Parser" },
      { img: n8nBi, caption: "Tool 1: BI_Supabase Operational & Financial Database Query" },
      { img: n8nSocial, caption: "Tool 2: Multi-Platform Social Media Video Performance Analytics" },
      { img: n8nMkt, caption: "Tool 3: Marketing Events Campaign Timeline Manager" },
      { img: n8nContent, caption: "Tool 4: Content Strategy & Short-Form Video Hook Writer" },
      { img: n8nLib, caption: "Tool 5: Script Library Validator with Two-Phase Confirmation" },
    ],
  },
};

const {
  title,
  subtitle: propSubtitle,
  tag,
  sakiProp,
  demoUrl,
  githubUrl,
  videoUrl,
  videoLabel = "Watch Video",
} = Astro.props;

const pathSlug = Astro.url.pathname.split("/").filter(Boolean).pop() || "bookkeeping";
const mapped = PROJECT_SAKI_MAP[pathSlug] || PROJECT_SAKI_MAP.bookkeeping;
const meta = PROJECT_DETAIL_CONFIG[pathSlug] || PROJECT_DETAIL_CONFIG.bookkeeping;

const resolvedProp: SakiPropName = sakiProp || mapped.prop;
const resolvedSubtitle = propSubtitle || meta.subtitle;
---

<header class="saki-detail-hero-plate" data-project-slug={pathSlug}>
  <!-- =========================================================================
      1. TOP HEADER: BACK TO PROJECTS, FOLDER TAG, TITLE, SAKI LAPTOP & BUTTONS
      ========================================================================= -->
  <div class="detail-top-grid">
    <!-- Kolom Kiri + Tengah (8 Kolom, sejajar dengan Browser Mockup Container) -->
    <div class="detail-top-left">
      <div class="detail-title-stack">
        <div>
          <a href="/#projects-section" class="btn-back-projects">
            <span>←</span>
            <span>Back to Projects</span>
          </a>
        </div>

        <!-- Folder Icon + SakiPropElement + Category Tag + Garis Kuning -->
        <div class="detail-kicker-row">
          <svg class="folder-kicker-icon" viewBox="0 0 20 20" fill="#F5C242">
            <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
          </svg>
          <span class="detail-prop-mini">
            <SakiPropElement name={resolvedProp} size={18} />
          </span>
          <span class="detail-kicker-text">{tag}</span>
          <span class="detail-kicker-bar"></span>
        </div>

        <!-- Judul Utama & Subjudul -->
        <h1 class="detail-main-title">{title}</h1>
        <p class="detail-main-subtitle">{resolvedSubtitle}</p>
      </div>

      <!-- Maskot Saki dengan Laptop Bersandar di Tepi Atas Mockup Container -->
      <div class="detail-saki-laptop-slot">
        <SakiLaptopHero width="100%" height="100%" />
      </div>
    </div>

    <!-- Kolom Kanan: Tombol Live Demo, View Source, atau Video (4 Kolom) -->
    <div class="detail-top-right">
      {demoUrl && (
        <div class="demo-btn-wrapper">
          <svg class="demo-rays-svg" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path d="M 10 14 C 9 11, 11 8, 14 9 C 16 10, 16 13, 15 16 L 13 21 C 12 23, 10 23, 9 21 Z" fill="#FDD365" />
            <path d="M 20 18 C 20 16, 23 15, 25 16 C 27 17, 26 20, 24 22 L 19 25 C 17 26, 16 24, 17 22 Z" fill="#FDD365" />
          </svg>
          <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="btn-detail-action btn-action-yellow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6m4-3h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Live Demo</span>
            <span>↗</span>
          </a>
        </div>
      )}

      {githubUrl && (
        <div class="source-btn-wrapper">
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn-detail-action btn-action-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>View Source</span>
            <span>↗</span>
          </a>
        </div>
      )}

      {videoUrl && (
        <div class="source-btn-wrapper">
          <a href={videoUrl} target="_blank" rel="noopener noreferrer" class="btn-detail-action btn-action-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z" />
            </svg>
            <span>{videoLabel.replace("↗", "").trim()}</span>
            <span>↗</span>
          </a>
        </div>
      )}

      {!demoUrl && !githubUrl && !videoUrl && (
        <div class="demo-btn-wrapper">
          <a href="#case-study-tabs" class="btn-detail-action btn-action-yellow">
            <span>Read Case Study</span>
            <span>↓</span>
          </a>
        </div>
      )}
    </div>
  </div>

  <!-- =========================================================================
      2. 2-COLUMN BENTO SHOWCASE: BROWSER MOCKUP CAROUSEL (KIRI) & OVERVIEW (KANAN)
      ========================================================================= -->
  <div class="bento-showcase-grid">
    <!-- KOLOM KIRI: CONTAINER MOCKUP DENGAN SLIDER INTERAKTIF (8 Kolom) -->
    <div class="bento-mockup-container" id="detail-mockup-carousel">
      {meta.slides.length > 1 && (
        <>
          <button type="button" class="mockup-nav-btn mockup-prev" id="mockup-prev-btn" aria-label="Previous screenshot">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button type="button" class="mockup-nav-btn mockup-next" id="mockup-next-btn" aria-label="Next screenshot">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}

      <!-- Frame Jendela Browser Putih -->
      <div class="browser-window-frame">
        <div class="browser-top-bar">
          <div class="traffic-dots">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <div class="browser-caption-bar" id="mockup-active-caption">
            {meta.slides[0].caption}
          </div>
          <div class="browser-slide-counter" id="mockup-slide-counter">
            1 / {meta.slides.length}
          </div>
        </div>

        <div class="browser-viewport">
          {meta.slides.map((slide, idx) => (
            <div
              class={`mockup-slide-item ${idx === 0 ? "is-active" : ""}`}
              data-slide-idx={idx}
              data-slide-caption={slide.caption}
            >
              <Image
                src={slide.img}
                alt={slide.caption}
                width={1100}
                height={680}
                loading={idx === 0 ? "eager" : "lazy"}
                decoding="async"
                class="mockup-slide-img"
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Indikator Titik Carousel di Bawah Layar -->
      <div class="mockup-dots-row" id="mockup-dots-row">
        {meta.slides.map((slide, idx) => (
          <button
            type="button"
            class={`mockup-dot ${idx === 0 ? "is-active" : ""}`}
            data-target-slide={idx}
            aria-label={`View screenshot ${idx + 1}: ${slide.caption}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- KOLOM KANAN: KARTU PROJECT OVERVIEW & METADATA (4 Kolom) -->
    <aside class="bento-overview-card">
      <div class="overview-card-top">
        <div class="overview-card-header">
          <span class="info-circle-badge">i</span>
          <h2 class="overview-card-title">Project Overview</h2>
        </div>
        <p class="overview-card-desc">{meta.overviewText}</p>
      </div>

      <div class="overview-divider"></div>

      <!-- 4 Baris Metadata Proyek (My Role, Tech Stack, Architecture/Scope, Team) -->
      <div class="overview-meta-list">
        <!-- Row 1: My Role -->
        <div class="meta-row">
          <div class="meta-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <circle cx="12" cy="8" r="4" />
              <path stroke-linecap="round" d="M5 20c0-3.5 3.1-6 7-6s7 2.5 7 6" />
            </svg>
            <span>My Role</span>
          </div>
          <span class="meta-pill pill-role">{meta.role}</span>
        </div>

        <!-- Row 2: Tech Stack -->
        <div class="meta-row">
          <div class="meta-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
            <span>Tech Stack</span>
          </div>
          <div class="meta-tech-list">
            {meta.techStack.map((t) => (
              <span class="tech-chip-pill">
                <span class="tech-dot"></span>
                <span>{t}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- Row 3: Scope / Architecture -->
        <div class="meta-row">
          <div class="meta-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <rect x="3" y="4" width="18" height="17" rx="2" />
              <path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18" />
            </svg>
            <span>Scope</span>
          </div>
          <span class="meta-pill pill-neutral">{meta.duration}</span>
        </div>

        <!-- Row 4: Team -->
        <div class="meta-row">
          <div class="meta-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <circle cx="9" cy="8" r="3.5" />
              <path stroke-linecap="round" d="M3 19c0-3 2.7-5 6-5s6 2 6 5" />
              <circle cx="17" cy="9" r="2.5" />
              <path stroke-linecap="round" d="M17 14c2.5 0 4.5 1.5 4.5 4" />
            </svg>
            <span>Team</span>
          </div>
          <span class="meta-pill pill-neutral">{meta.team}</span>
        </div>
      </div>
    </aside>
  </div>

  <!-- =========================================================================
