---
import CallToAction from "../CallToAction.astro";
import SakiGraphicFace from "../saki/SakiGraphicFace.astro";
import SakiPropElement from "../saki/SakiPropElement.astro";
import { PROJECT_SAKI_MAP, type SakiGraphicMood, type SakiPropName } from "../saki/sakiMoods";

interface SpecItem {
	label: string;
	value: string;
	highlight?: boolean;
}

interface Props {
	title: string;
	subtitle?: string;
	tag: string;
	awardText?: string;
	awardIcon?: string;
	sakiMood?: SakiGraphicMood;
	sakiProp?: SakiPropName;
	specs?: SpecItem[];
	demoUrl?: string;
	githubUrl?: string;
	videoUrl?: string;
	videoLabel?: string;
	backUrl?: string;
}

const {
	title,
	subtitle,
	tag,
	sakiMood,
	sakiProp,
	specs,
	demoUrl,
	githubUrl,
	videoUrl,
	videoLabel = "Motion Graphic ↗",
	backUrl = "/#work-hero"
} = Astro.props;

// Automatically resolve Saki mood & prop from URL path or title
const pathSlug = Astro.url.pathname.split("/").filter(Boolean).pop() || "";
const mapped = PROJECT_SAKI_MAP[pathSlug];
const resolvedMood: SakiGraphicMood = sakiMood || mapped?.mood || "working";
const resolvedProp: SakiPropName = sakiProp || mapped?.prop || "laptop";
---

<header class="tech-spec-plate">
	<!-- Top Navigation Breadcrumb -->
	<div class="plate-top-bar" style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
		<a href={backUrl} class="back-link fl-mono">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M19 12H5M12 19l-7-7 7-7"/>
			</svg>
			<span>Back to Works</span>
		</a>
		<div class="plate-tag-badge fl-mono" style="display: inline-flex; align-items: center; gap: 7px;">
			<SakiPropElement name={resolvedProp} size={18} />
			<span>{tag}</span>
		</div>
	</div>

	<!-- Main Title & Saki Contextual Companion -->
	<div class="plate-hero-row" style="display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 2rem; flex-wrap: wrap;">
		<div class="plate-title-group" style="flex: 1; min-width: 260px;">
			<h1 class="plate-main-title">{title}</h1>
			{subtitle && <p class="plate-subtitle">{subtitle}</p>}
		</div>
		<div class="plate-saki-companion" title={`Saki • ${resolvedMood}`} style="flex-shrink: 0; display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 20px; background: rgba(254, 247, 238, 0.04); border: 1px solid var(--farline-border);">
			<SakiGraphicFace mood={resolvedMood} size={96} transparentBg hideBubble />
		</div>
	</div>

	<!-- Farline-Inspired Technical Specifications Grid -->
	{specs && specs.length > 0 && (
		<div class="plate-specs-grid">
			{specs.map((item, idx) => (
				<div class="spec-cell">
					<div class="spec-cell-header fl-mono">
						<span class="spec-index">0{idx + 1}</span>
						<span class="spec-label">{item.label}</span>
					</div>
					<div class:list={["spec-cell-value", { "is-highlight": item.highlight }]}>
						{item.value}
					</div>
				</div>
			))}
		</div>
	)}

	<!-- Quick Action Links -->
	{(demoUrl || githubUrl || videoUrl) && (
		<div class="plate-actions-bar">
			{demoUrl && (
				<CallToAction href={demoUrl} target="_blank">
					Live Demo ↗
				</CallToAction>
			)}
			{githubUrl && (
				<CallToAction href={githubUrl} target="_blank">
					GitHub Repo ↗
				</CallToAction>
			)}
			{videoUrl && (
				<CallToAction href={videoUrl} target="_blank">
					{videoLabel}
				</CallToAction>
			)}
		</div>
	)}
</header>

<style lang="scss">
	.tech-spec-plate {
		position: relative;
		width: 100%;
		padding: 2.5rem 0 3rem;
		border-bottom: 1px solid var(--farline-hairline);
		margin-bottom: 2.5rem;
	}

	.plate-top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
		gap: 12px;
		flex-wrap: wrap;

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			color: var(--farline-text-muted);
			text-decoration: none;
			font-size: 0.75rem;
			transition: color 0.2s ease, transform 0.2s ease;

			&:hover {
				color: var(--farline-text-primary);
				transform: translateX(-3px);
			}
		}

		.plate-tag-badge {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			padding: 4px 12px 4px 8px;
			background: var(--farline-surface-muted);
			border: 1px solid rgba(254, 205, 94, 0.25);
			border-radius: 9999px;
			color: var(--farline-text-secondary);
			font-size: 0.72rem;
		}
	}

	.plate-hero-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 2rem;
	}

	.plate-title-group {
		flex: 1;

		.plate-main-title {
			font-size: clamp(1.9rem, 4.2vw, 3rem);
			font-weight: 700;
			color: var(--farline-text-primary);
			line-height: 1.15;
			letter-spacing: -0.03em;
			margin: 0;
			text-align: left;
		}

		.plate-subtitle {
			font-size: 1.08rem;
			color: var(--farline-text-secondary);
			margin: 12px 0 0;
			line-height: 1.5;
			max-width: 780px;
		}
	}

	.plate-saki-companion {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8px;
		border-radius: 20px;
		background: rgba(254, 247, 238, 0.04);
		border: 1px solid var(--farline-border);
	}

	/* Specifications Grid */
	.plate-specs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1px;
		background: var(--farline-hairline);
		border: 1px solid var(--farline-hairline);
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 2rem;
	}

	.spec-cell {
		background: var(--farline-surface);
		padding: 16px 18px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		transition: background-color 0.2s ease;

		&:hover {
			background: var(--farline-surface-muted);
		}

		.spec-cell-header {
			display: flex;
			align-items: center;
			gap: 8px;
			color: var(--farline-text-muted);
			font-size: 0.68rem;

			.spec-index {
				opacity: 0.6;
			}
		}

		.spec-cell-value {
			font-size: 0.92rem;
			font-weight: 500;
			color: var(--farline-text-primary);
			line-height: 1.4;

			&.is-highlight {
				color: var(--saki-yellow, #FECD5E);
				font-weight: 600;
			}
		}
	}

	.plate-actions-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	@media (max-width: 640px) {
		.plate-hero-row {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 14px;
		}

		.plate-specs-grid {
			grid-template-columns: 1fr;
		}

		.plate-actions-bar {
			flex-direction: column;
			width: 100%;

			:global(.btn) {
				width: 100%;
				text-align: center;
			}
		}
	}
</style>
