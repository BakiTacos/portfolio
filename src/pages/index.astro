<script>
  function setupSmoothScroll() {
    const navItems = document.querySelectorAll<HTMLAnchorElement>(".nav-item");
    const scrollLinks = document.querySelectorAll<HTMLAnchorElement>("[data-scroll-to]");

    function setActive(name: string) {
      navItems.forEach((item) => {
        if (item.getAttribute("data-nav") === name) {
          item.classList.add("is-active");
        } else {
          item.classList.remove("is-active");
        }
      });
    }

    scrollLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("data-scroll-to");
        if (!targetId) return;

        const navName = link.getAttribute("data-nav");
        if (navName) {
          setActive(navName);
        }

        // Temporarily pause scroll spy during programmatic smooth scroll
        (window as any).__isClickScrolling = true;
        setTimeout(() => {
          (window as any).__isClickScrolling = false;
        }, 900);

        if (targetId === "hero-section") {
          setActive("Home");
          window.scrollTo({
            top: 0,
            behavior: "smooth",
          });
          try {
            history.replaceState(null, "", "#hero-section");
          } catch (_) {}
          return;
        }

        let scrollTarget = document.getElementById(targetId);
        if (targetId === "projects-section") {
          const mainContent = document.getElementById("projects-main-content");
          if (mainContent) scrollTarget = mainContent;
        }

        if (scrollTarget) {
          const navBar = document.getElementById("saki-navbar");
          const navOffset = navBar ? navBar.getBoundingClientRect().height : 76;
          const targetPos = scrollTarget.getBoundingClientRect().top + window.pageYOffset - navOffset - 16;
          window.scrollTo({
            top: Math.max(0, targetPos),
            behavior: "smooth",
          });
          try {
            history.replaceState(null, "", `#${targetId}`);
          } catch (_) {}

          if (targetId === "about-section") {
            const bioBox = scrollTarget.querySelector(".about-bio-box") || scrollTarget;
            bioBox.classList.remove("about-highlight");
            void (bioBox as HTMLElement).offsetWidth; // trigger reflow
            bioBox.classList.add("about-highlight");
          }
        }
      });
    });

    // Explicit listener for "SCROLL TO EXPLORE" indicator in hero
    const exploreScrollBtn = document.querySelector<HTMLAnchorElement>(".scroll-explore-btn");
    if (exploreScrollBtn) {
      exploreScrollBtn.addEventListener("click", (e) => {
        e.preventDefault();
        const mainContent = document.getElementById("projects-main-content") || document.getElementById("projects-section");
        if (mainContent) {
          const navBar = document.getElementById("saki-navbar");
          const navOffset = navBar ? navBar.getBoundingClientRect().height : 76;
          const targetPos = mainContent.getBoundingClientRect().top + window.pageYOffset - navOffset - 16;
          window.scrollTo({
            top: Math.max(0, targetPos),
            behavior: "smooth",
          });
          try {
            history.replaceState(null, "", "#projects-section");
          } catch (_) {}
        }
      });
    }
  }

  function setupCarousel() {
    const btnExplore = document.getElementById("btn-explore-carousel");
    const carousel = document.getElementById("folders-carousel");
    if (!carousel) return;

    const stepWidth = 420;

    if (btnExplore) {
      btnExplore.addEventListener("click", () => {
        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        if (carousel.scrollLeft >= maxScroll - 30) {
          carousel.scrollTo({ left: 0, behavior: "smooth" });
        } else {
          carousel.scrollBy({ left: stepWidth, behavior: "smooth" });
        }
      });
    }

    // Mouse drag-to-scroll
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;
    let isDragging = false;
    const DRAG_THRESHOLD = 10;

    carousel.addEventListener("mousedown", (e) => {
      if (e.button !== 0) return;
      isDown = true;
      isDragging = false;
      startX = e.pageX;
      scrollStart = carousel.scrollLeft;
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      const deltaX = e.pageX - startX;

      if (!isDragging && Math.abs(deltaX) > DRAG_THRESHOLD) {
        isDragging = true;
        carousel.classList.add("is-dragging");
      }

      if (isDragging) {
        e.preventDefault();
        carousel.scrollLeft = scrollStart - deltaX;
      }
    });

    window.addEventListener("mouseup", () => {
      if (!isDown) return;
      isDown = false;

      if (isDragging) {
        carousel.classList.remove("is-dragging");
        const preventClickOnce = (clickEvent: MouseEvent) => {
          clickEvent.preventDefault();
          clickEvent.stopPropagation();
          window.removeEventListener("click", preventClickOnce, true);
        };
        window.addEventListener("click", preventClickOnce, true);
        setTimeout(() => {
          window.removeEventListener("click", preventClickOnce, true);
          isDragging = false;
        }, 120);
      } else {
        isDragging = false;
      }
    });
  }

  function setupActiveNavObserver() {
    const projSec = document.getElementById("projects-section");
    const projContent = document.getElementById("projects-main-content");
    const navItems = document.querySelectorAll<HTMLAnchorElement>(".nav-item");

    function setActive(name: string) {
      navItems.forEach((item) => {
        if (item.getAttribute("data-nav") === name) {
          item.classList.add("is-active");
        } else {
          item.classList.remove("is-active");
        }
      });
    }

    function onScrollSpy() {
      if ((window as any).__isClickScrolling) return;

      if (projSec) {
        const projRect = projSec.getBoundingClientRect();
        if (projRect.top <= 220) {
          setActive("Projects");
          if (projContent) projContent.classList.add("is-visible");
          return;
        }
      }

      setActive("Home");
    }

    window.addEventListener("scroll", onScrollSpy, { passive: true });
    onScrollSpy(); // initial check
  }

  function handleInitialHash() {
    const hash = window.location.hash;
    if (!hash || hash === "#hero-section") return;

    const targetId = hash.replace(/^#/, "");
    let scrollTarget = document.getElementById(targetId);
    if (targetId === "projects-section") {
      const mainContent = document.getElementById("projects-main-content");
      if (mainContent) scrollTarget = mainContent;
    }

    if (scrollTarget) {
      setTimeout(() => {
        const navBar = document.getElementById("saki-navbar");
        const navOffset = navBar ? navBar.getBoundingClientRect().height : 76;
        const targetPos = scrollTarget!.getBoundingClientRect().top + window.pageYOffset - navOffset - 16;
        window.scrollTo({
          top: Math.max(0, targetPos),
          behavior: "smooth",
        });
      }, 100);
    }
  }

  function init() {
    setupSmoothScroll();
    setupCarousel();
    setupActiveNavObserver();
    handleInitialHash();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  document.addEventListener("astro:page-load", init);
</script>

