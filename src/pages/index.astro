---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SakiLogoIcon from "../components/saki/SakiLogoIcon.astro";
import SakiProfileHeroMascot from "../components/saki/SakiProfileHeroMascot.astro";
import SakiPeekingMascot from "../components/saki/SakiPeekingMascot.astro";
import SakiPropElement from "../components/saki/SakiPropElement.astro";
import type { SakiPropName } from "../components/saki/sakiMoods";
import { homeTdk } from "../data/content";
import myPortrait from "../assets/portrait.jpg";

import imgBookkeeping from "../assets/projects/bookkeeping/cover.png";
import imgBridgeU from "../assets/projects/bridgeu/bridgeu-cover.png";
import imgDapurTwin from "../assets/projects/dapurtwin/cover-dapurtwin.png";
import imgTukangin from "../assets/projects/tukangin/tukangin-cover.png";
import imgSuparta from "../assets/projects/suparta/suparta-cover.webp";
import imgStudentSupport from "../assets/projects/studentsupport/studsop-cover.webp";
import imgPenerbangan from "../assets/projects/penerbangan/start.webp";
import imgIsfest from "../assets/projects/isfest/cover.webp";
import imgN8nOrchestra from "../assets/projects/n8n-orchestra/orchestra.webp";

const sakiEngineeringPillars: { prop: SakiPropName; label: string }[] = [
  { prop: "goggles", label: "Problem Framing" },
  { prop: "code-terminal", label: "Full-Stack Systems" },
  { prop: "database", label: "Relational Data" },
  { prop: "ai-spark", label: "AI & Automation" },
];

const allProjects: {
  num: string;
  theme: "yellow" | "blue" | "green" | "purple" | "amber" | "teal" | "rose" | "indigo" | "cyan";
  category: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  detailUrl: string;
  hasMascotPeek: boolean;
  sakiProp: SakiPropName;
  primaryTag: string;
  tags: string[];
}[] = [
  {
    num: "01",
    theme: "yellow",
    category: "DATA & ARCHITECTURE",
    title: "Bookkeeping & Financial Management System",
    subtitle: "Transactions, Inventory & Multi-Level Accounts",
    image: imgBookkeeping,
    detailUrl: "/detail/bookkeeping",
    hasMascotPeek: true,
    sakiProp: "database",
    primaryTag: "4-Stage Architecture",
    tags: ["Next.js", "PostgreSQL", "Finance Engine"],
  },
  {
    num: "02",
    theme: "blue",
    category: "EDUCATION & COLLABORATION",
    title: "BridgeU: University & Industry Platform",
    subtitle: "Academic Collaboration & Automated Verified Portfolios",
    image: imgBridgeU,
    detailUrl: "/detail/bridgeu",
    hasMascotPeek: false,
    sakiProp: "trophy",
    primaryTag: "Juara 2 — UBM Inspire 1.0",
    tags: ["Next.js", "Supabase", "Weighted Recs"],
  },
  {
    num: "03",
    theme: "green",
    category: "F&B SAAS & OPERATIONS",
    title: "DapurTwin: F&B Operational & POS SaaS",
    subtitle: "Smart Recipe BOM, Dynamic HPP & Real-Time KDS",
    image: imgDapurTwin,
    detailUrl: "/detail/dapurtwin",
    hasMascotPeek: false,
    sakiProp: "coffee",
    primaryTag: "Smart Recipe BOM Engine",
    tags: ["Next.js", "Supabase", "POS & KDS"],
  },
  {
    num: "04",
    theme: "purple",
    category: "MARKETPLACE & HEURISTICS",
    title: "Tukang.in: Technician Marketplace",
    subtitle: "Early Laravel Monolith, Location & Time Recommendation",
    image: imgTukangin,
    detailUrl: "/detail/tukangin",
    hasMascotPeek: false,
    sakiProp: "code-terminal",
    primaryTag: "Heuristic Matching",
    tags: ["Laravel", "MySQL", "Query Optimization"],
  },
  {
    num: "05",
    theme: "amber",
    category: "BRAND & COMMERCE",
    title: "SUPARTA: Brand & Sales Platform",
    subtitle: "Brand Building, Multi-Language & High-Ticket Sales",
    image: imgSuparta,
    detailUrl: "/detail/suparta",
    hasMascotPeek: false,
    sakiProp: "lightbulb",
    primaryTag: "Brand & Sales Enablement",
    tags: ["Next.js i18n", "Brand Strategy", "Sales Flow"],
  },
  {
    num: "06",
    theme: "teal",
    category: "FIRST CODEBASE & RESEARCH",
    title: "Student Support UMN: First Website",
    subtitle: "Early Database, User Interviews & Web Fundamentals",
    image: imgStudentSupport,
    detailUrl: "/detail/studentsupport",
    hasMascotPeek: false,
    sakiProp: "open-book",
    primaryTag: "Field Research & First DB",
    tags: ["HTML5 / CSS3", "JavaScript", "User Interviews"],
  },
  {
    num: "07",
    theme: "rose",
    category: "DATA ANALYTICS & ML",
    title: "Flight Delay Analytics (XGBoost)",
    subtitle: "Big Data Processing, CRISP-DM & Predictive Modeling",
    image: imgPenerbangan,
    detailUrl: "/detail/penerbangan",
    hasMascotPeek: false,
    sakiProp: "magnifier",
    primaryTag: "CRISP-DM Pipeline",
    tags: ["XGBoost", "Python", "Streamlit"],
  },
  {
    num: "08",
    theme: "indigo",
    category: "BACKEND & CLOUD STORAGE",
    title: "ISFEST UMN 2026: Backend & Fallback",
    subtitle: "Failover Resilience, Backblaze B2 & Org Operations",
    image: imgIsfest,
    detailUrl: "/detail/isfest",
    hasMascotPeek: false,
    sakiProp: "shield",
    primaryTag: "Graceful Fallback & B2",
    tags: ["Backend API", "Backblaze B2", "Data Security"],
  },
  {
    num: "09",
    theme: "cyan",
    category: "AI AGENT & AUTOMATION",
    title: "Telegram AI Orchestrator (n8n)",
    subtitle: "Unified Multi-Agent Assistant & Context-Aware Tool Calling",
    image: imgN8nOrchestra,
    detailUrl: "/detail/n8n-orchestra",
    hasMascotPeek: false,
    sakiProp: "ai-spark",
    primaryTag: "Multi-Agent Orchestrator",
    tags: ["n8n", "LangChain", "Supabase"],
  },
];
---

<BaseLayout
  title={homeTdk.title || "Kevin Sakia Putra — Portfolio"}
  description={homeTdk.description || "Personal portfolio showcasing projects in software development, data, business, and AI."}
  keywords={homeTdk.keywords || "portfolio, software engineering, bookkeeping, system design, data architecture"}
>
  <div class="saki-portfolio-root">
    <!-- =========================================================================
        STICKY GLOBAL NAVBAR (IKON SAKI TANPA TEKS NAMA • HOME, ABOUT, PROJECTS)
        ========================================================================= -->
    <header class="saki-navbar" id="saki-navbar">
      <div class="nav-container">
        <a href="#hero-section" class="nav-brand" data-scroll-to="hero-section" aria-label="Home">
          <SakiLogoIcon size={44} class="nav-logo-icon" />
        </a>

        <nav class="nav-menu" aria-label="Main Navigation">
          <a href="#hero-section" class="nav-item is-active" data-nav="Home" data-scroll-to="hero-section">Home</a>
          <a href="#projects-section" class="nav-item" data-nav="Projects" data-scroll-to="projects-section">Projects</a>
        </nav>
      </div>
    </header>

    <!-- =========================================================================
        SECTION 1: HERO & ABOUT INTEGRATED (DENGAN FOTO PROFIL, BIO, SAKI PROPS & SOCIALS)
        ========================================================================= -->
    <div id="hero-section" class="hero-section">
      <!-- Dekorasi Awan Kiri Atas -->
      <div class="cloud-decor-left" aria-hidden="true">
        <svg viewBox="0 0 240 450" fill="none" class="decor-svg">
          <path
            d="M 0 0 C 85 0, 140 45, 138 110 C 185 125, 200 185, 165 235 C 195 270, 180 340, 125 365 C 85 385, 35 415, 0 435 Z"
            fill="#DCEFF9"
          />
          <path
            d="M 54 115 H 122 C 134 115, 142 106, 140 95 C 138 86, 130 81, 121 82 C 117 68, 104 58, 89 58 C 72 58, 59 70, 57 85 C 46 86, 38 94, 39 104 C 40 111, 46 115, 54 115 Z"
            fill="#FFFFFF"
            opacity="0.82"
          />
        </svg>
      </div>

      <!-- Dekorasi Awan Kanan Atas -->
      <div class="cloud-decor-right" aria-hidden="true">
        <svg viewBox="0 0 280 420" fill="none" class="decor-svg">
          <path
            d="M 280 10 C 230 10, 205 42, 212 78 C 145 78, 100 118, 108 172 C 114 215, 162 238, 212 235 C 175 268, 185 335, 280 375 Z"
            fill="#DCEFF9"
          />
        </svg>
      </div>

      <!-- Dekorasi Bukit Hijau & Tunas Daun di Bawah -->
      <div class="hills-decor-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 170" preserveAspectRatio="none" fill="none" class="decor-svg">
          <path d="M 0 170 L 0 95 Q 190 92 380 135 Q 480 158 550 170 Z" fill="#C2DA9B" />
          <path
            d="M 0 170 L 0 42 C 26 38, 46 55, 44 76 C 68 72, 86 90, 80 112 C 102 110, 118 124, 116 142 C 185 138, 255 152, 305 170 Z"
            fill="#8CAE72"
          />
          <ellipse cx="64" cy="144" rx="6" ry="11" transform="rotate(-28 64 144)" fill="#CDE397" />
          <ellipse cx="82" cy="150" rx="5.5" ry="9.5" transform="rotate(24 82 150)" fill="#CDE397" />
          <circle cx="95" cy="130" r="4.5" fill="#CDE397" opacity="0.85" />

          <path d="M 810 170 Q 940 90 1140 82 Q 1300 76 1440 110 L 1440 170 Z" fill="#DCEFF9" />
          <path d="M 940 170 Q 1040 120 1180 126 L 1440 170 Z" fill="#C2DA9B" />
          <path d="M 1115 170 C 1150 92, 1245 78, 1320 96 C 1365 62, 1415 54, 1440 62 L 1440 170 Z" fill="#8CAE72" />
          <circle cx="1272" cy="128" r="6" fill="#CDE397" />
          <ellipse cx="1344" cy="148" rx="7" ry="13" transform="rotate(-32 1344 148)" fill="#CDE397" />
          <ellipse cx="1366" cy="154" rx="6" ry="11" transform="rotate(26 1366 154)" fill="#CDE397" />
          <ellipse cx="1378" cy="134" rx="4.5" ry="7.5" transform="rotate(15 1378 134)" fill="#CDE397" />
        </svg>
      </div>

      <!-- MAIN HERO & ABOUT CONTENT -->
      <main class="hero-main-container">
        <div class="hero-grid">
          <!-- Kolom Kiri: Maskot Saki Besar Melambai -->
          <div class="hero-col-mascot">
            <div class="hero-mascot-wrapper">
              <SakiProfileHeroMascot class="saki-hero-svg" />
            </div>
          </div>

          <!-- Kolom Kanan: Identitas, Foto Profil, Bio About, Saki Props & Socials -->
          <div class="hero-col-content" id="about-section">
            <!-- Baris Identitas: Foto Profil + Kicker + Nama & Peran -->
            <div class="identity-head-row">
              <div class="portrait-ring">
                <Image
                  src={myPortrait}
                  alt="Kevin Sakia Putra"
                  width={80}
                  height={80}
                  class="portrait-photo"
                  loading="eager"
                  decoding="async"
                />
              </div>

              <div class="identity-titles">
                <div class="kicker-group">
                  <span class="kicker-text">HELLO, I'M</span>
                  <span class="kicker-bar"></span>
                </div>
                <h1 class="hero-title">Kevin Sakia Putra</h1>
                <p class="hero-role-tagline">
                  Information Systems Student <span class="role-dot">•</span> Software &amp; Data Architecture
                </p>
              </div>
            </div>

            <!-- Narasi Terintegrasi Home & About -->
            <div class="about-bio-box">
              <p class="bio-paragraph">
                I’m an Information Systems student who enjoys turning real-world problems into practical, scalable solutions through technology. My focus sits at the intersection of <strong>software development, relational database architecture, business systems, and AI</strong>.
              </p>
              <p class="bio-paragraph">
                I enjoy working through the process from identifying a problem and exploring solutions to building, testing, and improving based on what I learn across multiple iterations.
              </p>
            </div>

            <!-- Strip Elemen Maskot Saki (SakiPropElement) -->
            <div class="saki-pillars-strip" aria-label="Focus Areas">
              {sakiEngineeringPillars.map((pillar) => (
                <div class="saki-pillar-chip">
                  <span class="pillar-icon-box">
                    <SakiPropElement name={pillar.prop} size={22} />
                  </span>
                  <span class="pillar-label">{pillar.label}</span>
                </div>
              ))}
            </div>

            <!-- Baris Tombol CTA & Social Media Links -->
            <div class="cta-and-socials-row">
              <div class="cta-row">
                <a href="#projects-section" class="btn-cta btn-yellow" data-scroll-to="projects-section">
                  <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd" />
                    <path d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z" />
                  </svg>
                  <span>View Projects</span>
                  <span class="btn-arrow">→</span>
                </a>

                <a href="/assets/CV_Kevin_Sakia_Putra.pdf" download="CV_Kevin_Sakia_Putra.pdf" class="btn-cta btn-outline">
                  <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                  <span>Download CV</span>
                </a>
              </div>

              <!-- Social Media Icon Buttons (Ukuran SVG Presisi 18px) -->
              <div class="social-links-bar" aria-label="Social Media Links">
                <a
                  href="https://github.com/BakiTacos"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-icon-btn"
                  aria-label="GitHub"
                  title="GitHub (@BakiTacos)"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                  <span>GitHub</span>
                </a>

                <a
                  href="https://www.linkedin.com/in/kevin-sakia-putra-2661a42a7"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-icon-btn"
                  aria-label="LinkedIn"
                  title="LinkedIn (Kevin Sakia Putra)"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                  </svg>
                  <span>LinkedIn</span>
                </a>

                <a
                  href="https://www.instagram.com/kevin.sakia"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-icon-btn"
                  aria-label="Instagram"
                  title="Instagram (@kevin.sakia)"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
                  </svg>
                  <span>Instagram</span>
                </a>

                <a
                  href="mailto:contact@sakia.id"
                  class="social-icon-btn"
                  aria-label="Email"
                  title="contact@sakia.id"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                  <span>Email</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- BOTTOM SCROLL INDICATOR -->
      <div class="hero-bottom-scroll">
        <a href="#projects-section" class="scroll-explore-btn" data-scroll-to="projects-section">
          <div class="mouse-pill">
            <span class="mouse-wheel"></span>
          </div>
          <span class="scroll-text">SCROLL TO EXPLORE</span>
          <svg class="scroll-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- =========================================================================
        SMOOTH TRANSITION CONNECTOR BRIDGE (ANTARA SECTION 1 DAN SECTION 2)
        ========================================================================= -->
    <div class="transition-connector" aria-hidden="true">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" fill="none" class="transition-svg">
        <path
          d="M 0 0 C 380 70, 720 90, 1080 30 C 1240 10, 1360 20, 1440 30 L 1440 0 L 0 0 Z"
          fill="#8CAE72"
          opacity="0.35"
        />
        <path
          d="M 0 0 C 300 55, 680 75, 1020 38 C 1220 20, 1350 32, 1440 48 L 1440 120 L 0 120 Z"
          fill="#FCF8F2"
        />
        <path
          d="M 220 50 H 270 C 278 50, 284 44, 282 37 C 281 31, 275 27, 268 28 C 265 19, 256 12, 245 12 C 233 12, 223 20, 222 30 C 214 31, 208 36, 209 43 C 210 48, 214 50, 220 50 Z"
          fill="#FFFFFF"
          opacity="0.85"
        />
        <path
          d="M 1180 42 H 1235 C 1244 42, 1250 35, 1248 27 C 1246 20, 1239 16, 1232 17 C 1228 7, 1218 0, 1206 0 C 1193 0, 1182 9, 1180 20 C 1172 21, 1165 27, 1166 35 C 1167 40, 1172 42, 1180 42 Z"
          fill="#FFFFFF"
          opacity="0.8"
        />
      </svg>
    </div>

    <!-- =========================================================================
        SECTION 2: DAFTAR 9 PROJECT FOLDERS (DENGAN SAKI PROP ELEMENTS & SLIDER)
        ========================================================================= -->
    <section id="projects-section" class="projects-section">
      <!-- Dekorasi Awan Atas & Bukit Bawah untuk Section 2 -->
      <div class="proj-decor-cloud-left" aria-hidden="true">
        <svg viewBox="0 0 320 180" fill="none" class="decor-svg">
          <path d="M 0 0 H 280 C 265 65, 195 110, 110 115 C 55 118, 20 145, 0 175 Z" fill="#DCEFF9" opacity="0.7" />
        </svg>
      </div>
      <div class="proj-decor-cloud-right" aria-hidden="true">
        <svg viewBox="0 0 420 220" fill="none" class="decor-svg">
          <path d="M 420 0 H 80 C 110 60, 195 85, 285 85 C 350 85, 390 120, 420 175 Z" fill="#DCEFF9" opacity="0.75" />
          <path
            d="M 255 128 H 318 C 328 128, 335 120, 333 111 C 331 103, 324 98, 316 99 C 312 87, 301 79, 287 79 C 272 79, 260 89, 258 102 C 248 103, 241 110, 242 119 C 243 125, 248 128, 255 128 Z"
            fill="#FFFFFF"
            opacity="0.9"
          />
        </svg>
      </div>

      <!-- Bukit Hijau Bawah Section 2 -->
      <div class="proj-hills-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 160" preserveAspectRatio="none" fill="none" class="decor-svg">
          <path d="M 0 160 L 0 85 Q 160 85 330 140 L 390 160 Z" fill="#C2DA9B" />
          <path d="M 0 160 L 0 35 C 28 32, 46 50, 44 72 C 68 68, 85 88, 80 110 C 102 108, 118 125, 116 145 L 220 160 Z" fill="#8CAE72" />
          <ellipse cx="48" cy="144" rx="5.5" ry="10" transform="rotate(-28 48 144)" fill="#CDE397" />
          <ellipse cx="64" cy="149" rx="5" ry="8.5" transform="rotate(24 64 149)" fill="#CDE397" />

          <path d="M 1030 160 Q 1160 105 1330 105 L 1440 160 Z" fill="#C2DA9B" />
          <path d="M 1250 160 C 1275 110, 1320 95, 1365 108 C 1390 78, 1420 72, 1440 80 L 1440 160 Z" fill="#8CAE72" />
          <ellipse cx="1372" cy="145" rx="5.5" ry="10" transform="rotate(-28 1372 145)" fill="#CDE397" />
          <ellipse cx="1390" cy="150" rx="5.5" ry="8.5" transform="rotate(24 1390 150)" fill="#CDE397" />
        </svg>
      </div>

      <!-- MAIN CONTENT SECTION 2: KIRI INTRO + SAKI, KANAN 3D FOLDER CARDS -->
      <div class="projects-main-container" id="projects-main-content">
        <div class="projects-grid">
          <!-- Sisi Kiri: PORTFOLIO + Projects + Maskot Saki Melambai (Tanpa Deskripsi) -->
          <div class="projects-col-intro">
            <div class="kicker-group">
              <span class="kicker-text">PORTFOLIO</span>
              <span class="kicker-bar"></span>
            </div>

            <h2 class="projects-title">Projects</h2>

            <div class="proj-mascot-wrapper">
              <SakiProfileHeroMascot class="saki-proj-svg" />
            </div>
          </div>

          <!-- Sisi Kanan: 3D Claymorphic Folder Cards Carousel (9 Projects) -->
          <div class="projects-col-carousel">
            <div class="folders-carousel" id="folders-carousel">
              {
                allProjects.map((p) => (
                  <div class={`folder-card folder-${p.theme}`}>
                    <div class="folder-body-wrapper">
                      <!-- Tab Kiri Atas Folder -->
                      <a href={p.detailUrl} class={`folder-tab tab-${p.theme}`} aria-label={`Project ${p.num}: ${p.title}`}>
