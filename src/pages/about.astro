---
import { Image } from 'astro:assets';
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import {pageTag, pageDescription,aboutTdk} from '../data/content';
import myPortrait from "../assets/portrait.jpg";
---
<BlogPostLayout
	title={aboutTdk.title || ''}
	description = {aboutTdk.description || ''}
	keywords = {aboutTdk.keywords || ''}
>

	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.about}
				description={pageDescription.about}>
				 About Me
			</SectionHeader>
			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<div>
						<Image src={myPortrait} alt="Kevin Sakia Putra" width="88" height="88" class="portrait" loading="eager" decoding="async" />
					</div>
					<p>
						I’m an Information Systems student who enjoys turning real-world problems into practical solutions through technology.
					</p>
					<p>
						My interests sit at the intersection of software development, data, business, and AI. I build systems, analyze data, experiment with automation, and run digital business projects-not just to learn the technology, but to understand how it can actually solve problems.
					</p>
					<p>
						I enjoy working through the process from identifying a problem, exploring possible solutions, building, testing, and improving based on what I learn. Some of my projects have evolved through multiple iterations, and I see that process as an important part of learning.
					</p>

				</div>
			</section>
			<section>
				<h3 class="post-title">Beyond Work & Studies</h3>
				<div class="content">
					<p>
						Outside of coding and business projects, I enjoy exploring new technologies, watching drama films, and read comics.
					</p>
					<p>Interested in collaborating or discussing an idea? Feel free to reach out!</p>
					<p style="margin-top:24px;">
						<CallToAction
						target="_self"
						href="mailto:kevinsakia.p@gmail.com"
						>
							Contact Me
						</CallToAction>
					</p>
				</div>
			</section>
			<p></p>
			<p></p>
		</main>
	</div>
</BlogPostLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		margin:0 auto;
	}
	p{
		margin:0.75rem 0;
	}
	figure{
		margin:2rem 0;
	}
	img{max-width: 100%;}
	.portrait{
		border-radius: 100px;
		margin:12px 0 12px;
		overflow: hidden;
		text-align: left;
	}
	a, a:link{
		color:var(--color-blue);
	}
</style>
