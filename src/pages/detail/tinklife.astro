---
import { Image } from "astro:assets";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import PostHeader from "../../components/PostHeader.astro";
const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/travel/*.{jpg,png,webp}', {
		eager: true,
	})
);
// 导入 Image 组件和图像
---
<DetailPostLayout
	title="Tink Life | Portfolio"
	description = 'Rico & Tink: Diary Life - Mobile-first website for travel journals, independently designed and built.',
	keywords = 'diary life, travel journal, mobile web, figma, vue',
>
	<div class="post">
		<main class="post-wrapper">
				<PostHeader
					tag="Project"
					description="">
						<h1 class="font-type">
							Rico & Tink: Diary Life
						</h1>
				</PostHeader>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title">Design & Technology: Figma & Vue</h3>
							<p class="post-desc">
								A mobile-first website for documenting travel memories and daily life moments. Built from wireframing and UI prototyping to frontend implementation.
							</p>
						</div>
					</div>
				</div>
			</section>
			<section class="preview">
				{images.map((img, index) => (
					<picture class="gsap-picture">
					  <Image src={img.default} alt={`Travel Screenshot ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
					</picture>
				  ))}
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
.icon{
	color:var(--color-900);
}
</style>

<script>
	var images = document.getElementsByTagName('img');
 	for (var i = 0; i < images.length; i++) {
	// 为每个 img 标签添加 draggable="false" 属性
	images[i].setAttribute('draggable', 'false');
	images[i].setAttribute('ref', 'nofollow');
  }
</script>
