---
import { Image } from "astro:assets";
import DetailHeader from "../../components/DetailHeader.astro";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import CallToAction from "../../components/CallToAction.astro";

const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/free-3d-valentines-assets/*.{jpg,png,webp}', {
		eager: true,
	})
);


---
<DetailPostLayout
	title="Free Valentine's Day 3D Blender Assets | Portfolio"
	description = 'Koleksi aset dan ikon 3D gratis bertema Valentine yang siap digunakan untuk UI/UX dan web design.',
	keywords = '3D assets, ikon 3D, blender, valentine, desain UI',
>
	<div class="post">
		<main class="post-wrapper">
			<DetailHeader
			tag="3D ASSETS"
			description="">
					<h1 class="font-type">
						Valentine's Day 3D Blender Assets
					</h1>
			</DetailHeader>

				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title" style="margin-bottom:1em;">Paket Ikon 3D Gratis - Hari Valentine</h3>

							<p>Ikon 3D Valentine ini sangat cocok untuk desain UI, web design, landing page, dan proyek grafis lainnya.</p>
							<p class="post-desc">
								- Berkas 3D Blender (Mudah dikustomisasi)<br/>
								- Gaya warna Putih dan Pink<br/>
								- Gambar resolusi tinggi 3000x3000px (PNG)
							</p>
						</div>
						<div class="col-1a">
								<p style="margin-top: 12px;">👉 Unduh:</p>
								<div class="btn btn-grid" style="margin-top: 12px;">
									<CallToAction  target="_blank" href="http://web.606design.art/landings/004-free-3d-valentines-assets/">Landing Page </CallToAction>
									<CallToAction  target="_blank" href="https://www.figma.com/community/file/1363451172790940214/free-3d-icons-valentines-day/">Figma Community</CallToAction>
									<CallToAction  target="_blank" href="https://drive.google.com/drive/folders/171VScCkzSfubCOp_wQRnyMmUTBWGPJEe">Google Drive
									</CallToAction>
								</div>
						</div>
					</div>
				</div>
			</section>
			<section class="preview">
				{images.map((img, index) => (
					<picture class="picture">
					  <Image src={img.default} alt={`Image ${index + 1}`}   loading="lazy" decoding="async" />
					</picture>
				  ))}
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
	.btn-grid{
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
</style>
