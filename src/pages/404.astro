---
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import SakiGraphicFace from "../components/saki/SakiGraphicFace.astro";
import { notFoundTdk } from "../data/content";
---
<BlogPostLayout
	title={notFoundTdk.title || '404 Not Found'}
	description={notFoundTdk.description || ''}
	keywords={notFoundTdk.keywords || ''}
>
	<div class="post">
		<main class="post-wrapper 404">
			<section>
				<div class="content not-found-box">
					<div class="saki-404-stage">
						<SakiGraphicFace
							mood="searching"
							size={210}
							transparentBg
							hideBubble={false}
							customSay="Hmm... halaman ini tidak ditemukan!"
						/>
					</div>
					<p class="text">
						<strong>404 Not Found</strong><br/>
						The page you are looking for does not exist or has been moved.
					</p>
					<div class="btn">
						<CallToAction href="/" target="_self">
							Back to Home
						</CallToAction>
					</div>
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style>
	body {
		min-height: 100vh;
	}
	.not-found-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding-top: 3rem;
	}
	.saki-404-stage {
		margin-bottom: 1rem;
	}
	p {
		text-align: center;
	}
	.btn {
		margin: 2rem auto 4em;
		text-align: center;
	}
</style>
