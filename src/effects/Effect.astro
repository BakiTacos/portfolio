---
import SakiPropElement from "../components/saki/SakiPropElement.astro";
import type { SakiPropName } from "../components/saki/sakiMoods";

const sakiTrailProps: SakiPropName[] = [
  "goggles",
  "ai-spark",
  "code-terminal",
  "database",
  "rocket",
  "coffee",
  "trophy",
  "shield",
  "backpack",
  "compass",
];
---

<div class="train-1" aria-hidden="true">
  <div class="effects saki-trail-effects">
    {
      sakiTrailProps.map((prop) => (
        <div class="effects__img">
          <div class="effects__img-inner">
            <div class="saki-trail-badge">
              <SakiPropElement name={prop} size={56} />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script is:inline src="/plugins/effects/gsap.min.js"></script>
<script is:inline type="module">
  import { ImageTrail } from "/plugins/effects/imageTrail.js";

  function initSakiTrail() {
    const effectsEl = document.querySelector(".effects");
    if (!effectsEl || effectsEl.dataset.trailInit === "1") return;
    if (window.matchMedia("(max-width: 768px)").matches || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const startTrail = () => {
      if (typeof window.gsap === "undefined") {
        setTimeout(startTrail, 60);
        return;
      }
      effectsEl.dataset.trailInit = "1";
      window.__sakiImageTrail = new ImageTrail(effectsEl);
    };

    startTrail();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSakiTrail);
  } else {
    initSakiTrail();
  }
  document.addEventListener("astro:page-load", initSakiTrail);
</script>

<style is:global>
  .train-1 {
    position: fixed;
    inset: 0;
    z-index: 45;
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    overflow: hidden;
  }

  .effects {
    --img-width: 76px;
    --img-ratio: 1;
    --img-offset-x: 0px;
    --img-offset-y: 0px;
    --img-border-radius: 20px;
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none !important;
  }

  .effects__img {
    width: var(--img-width);
    aspect-ratio: var(--img-ratio);
    border-radius: var(--img-border-radius);
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    overflow: visible;
    will-change: transform;
    pointer-events: none !important;
  }

  .effects__img-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    pointer-events: none !important;
  }

  .saki-trail-badge {
    width: 68px;
    height: 68px;
    border-radius: 20px;
    background-color: rgba(255, 253, 248, 0.92);
    border: 2px solid #231F25;
    box-shadow: 0 8px 20px rgba(35, 31, 37, 0.14), inset 0 2px 4px rgba(255, 255, 255, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none !important;
  }

  @media (max-width: 768px) {
    .train-1 {
      display: none !important;
    }
  }
</style>
